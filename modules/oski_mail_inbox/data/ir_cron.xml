<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_backlog_import" model="ir.cron">
        <field name="name">Messagerie : import historique des boîtes</field>
        <field name="model_id" ref="model_oski_mailbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_backlog()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_imap_actions" model="ir.cron">
        <field name="name">Messagerie : rejouer les actions IMAP en attente</field>
        <field name="model_id" ref="model_oski_mail_imap_action"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_imap_actions()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
