<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mailbox_list" model="ir.ui.view">
        <field name="name">oski.mailbox.list</field>
        <field name="model">oski.mailbox</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="imap_host"/>
                <field name="backlog_state" widget="badge"/>
                <field name="backlog_done_count"/>
            </list>
        </field>
    </record>

    <record id="view_mailbox_form" model="ir.ui.view">
        <field name="name">oski.mailbox.form</field>
        <field name="model">oski.mailbox</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Tester la connexion" class="btn-secondary"
                            invisible="not fetchmail_server_id"/>
                    <button name="action_start_backlog" type="object"
                            string="Importer l'historique" class="btn-primary"
                            invisible="not fetchmail_server_id or backlog_state in ('pending', 'running')"
                            confirm="Importer tous les emails INBOX depuis la date « Importer depuis » ? L'import tourne en arrière-plan par tranches."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la boîte"/></h1>
                    </div>
                    <group>
                        <group string="Boîte">
                            <field name="email"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="fetchmail_server_id"/>
                        </group>
                        <group string="Connexion IMAP">
                            <field name="imap_host"/>
                            <field name="imap_port"/>
                            <field name="imap_ssl"/>
                            <field name="imap_user"/>
                            <field name="imap_password" password="True" groups="base.group_system"/>
                        </group>
                    </group>
                    <group string="Import historique">
                        <field name="backlog_since"/>
                        <field name="backlog_state"/>
                        <field name="backlog_done_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mailbox" model="ir.actions.act_window">
        <field name="name">Boîtes email</field>
        <field name="res_model">oski.mailbox</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
