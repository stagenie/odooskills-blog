<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imap_action_list" model="ir.ui.view">
        <field name="name">oski.mail.imap.action.list</field>
        <field name="model">oski.mail.imap.action</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-muted="state == 'done'">
                <field name="create_date" string="Mise en file le"/>
                <field name="mailbox_id"/>
                <field name="inbox_id"/>
                <field name="operation"/>
                <field name="attempts"/>
                <field name="result" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>
                <field name="last_error" optional="hide"/>
                <button name="action_retry" type="object" string="Rejouer"
                        icon="fa-refresh" invisible="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_imap_action_form" model="ir.ui.view">
        <field name="name">oski.mail.imap.action.form</field>
        <field name="model">oski.mail.imap.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" type="object" string="Rejouer"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="mailbox_id" readonly="1"/>
                            <field name="inbox_id" readonly="1"/>
                            <field name="operation" readonly="1"/>
                            <field name="email_message_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="attempts" readonly="1"/>
                            <field name="result" readonly="1"/>
                        </group>
                    </group>
                    <group string="Dernière erreur">
                        <field name="last_error" readonly="1" nolabel="1"
                               placeholder="Aucune erreur enregistrée"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_imap_action" model="ir.actions.act_window">
        <field name="name">File de synchronisation</field>
        <field name="res_model">oski.mail.imap.action</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rien en attente</p>
            <p>Les suppressions et classements qui n'ont pas pu atteindre le serveur
               apparaissent ici et sont rejoués automatiquement.</p>
        </field>
    </record>
</odoo>
