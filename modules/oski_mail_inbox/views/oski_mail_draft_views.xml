<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_draft_form" model="ir.ui.view">
        <field name="name">oski.mail.draft.form</field>
        <field name="model">oski.mail.draft</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Envoyer"
                            class="btn-primary" invisible="state == 'sent'"/>
                    <button name="action_open_original" type="object"
                            string="Voir l'email d'origine" class="btn-secondary"
                            invisible="not inbox_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="mailbox_id" readonly="state == 'sent'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="email_to" readonly="state == 'sent'"
                                   placeholder="destinataire@example.com, autre@example.com"/>
                            <field name="email_cc" readonly="state == 'sent'"/>
                        </group>
                        <group>
                            <field name="inbox_id" invisible="not inbox_id" readonly="1"/>
                            <field name="date_sent" invisible="state != 'sent'"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject" nolabel="1" readonly="state == 'sent'"
                               placeholder="Sujet"/>
                    </group>
                    <field name="body_html" readonly="state == 'sent'"/>
                    <field name="attachment_ids" widget="many2many_binary"
                           string="Pièces jointes" readonly="state == 'sent'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_draft_list" model="ir.ui.view">
        <field name="name">oski.mail.draft.list</field>
        <field name="model">oski.mail.draft</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'sent'">
                <field name="write_date" string="Modifié le"/>
                <field name="mailbox_id"/>
                <field name="email_to"/>
                <field name="subject"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="action_draft" model="ir.actions.act_window">
        <field name="name">Brouillons</field>
        <field name="res_model">oski.mail.draft</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun brouillon</p>
            <p>Répondez à un email reçu, ou composez un message neuf.</p>
        </field>
    </record>
</odoo>
