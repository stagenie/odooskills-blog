<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_inbox_list" model="ir.ui.view">
        <field name="name">oski.mail.inbox.list</field>
        <field name="model">oski.mail.inbox</field>
        <field name="arch" type="xml">
            <list decoration-bf="state == 'new'" decoration-muted="state == 'done'">
                <field name="date_received"/>
                <field name="mailbox_id"/>
                <field name="email_from"/>
                <field name="subject"/>
                <field name="partner_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'answered'"
                       decoration-danger="state == 'spam'"/>
            </list>
        </field>
    </record>

    <record id="view_mail_inbox_kanban" model="ir.ui.view">
        <field name="name">oski.mail.inbox.kanban</field>
        <field name="model">oski.mail.inbox</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="subject"/></strong>
                            <div class="text-muted"><field name="email_from"/></div>
                            <div class="d-flex justify-content-between">
                                <field name="mailbox_id"/>
                                <field name="date_received" widget="date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_mail_inbox_form" model="ir.ui.view">
        <field name="name">oski.mail.inbox.form</field>
        <field name="model">oski.mail.inbox</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_delete_email" type="object" string="Supprimer"
                            class="btn-secondary" invisible="not active"
                            confirm="Déplacer cet email vers la corbeille du serveur et archiver la fiche ?"/>
                    <button name="action_mark_spam" type="object" string="Indésirable"
                            class="btn-secondary" invisible="not active or state == 'spam'"
                            confirm="Déplacer cet email vers les indésirables du serveur et bloquer l'expéditeur sur toutes les boîtes ? Vous ne pourrez pas lever ce blocage vous-même."/>
                    <button name="action_mark_done" type="object" string="Clore"
                            invisible="state == 'done'"/>
                    <button name="action_mark_new" type="object" string="Rouvrir"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,answered,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="status" invisible="not imap_pending">
                        Synchronisation avec le serveur en attente : le geste sera rejoué
                        automatiquement.
                    </div>
                    <div class="alert alert-danger" role="status" invisible="not imap_failed">
                        Synchronisation impossible avec le serveur. Contactez votre
                        administrateur.
                    </div>
                    <div class="oe_title">
                        <h1><field name="subject" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mailbox_id" readonly="1"/>
                            <field name="email_from" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date_received" readonly="1"/>
                            <field name="active" invisible="1"/>
                            <field name="imap_pending" invisible="1"/>
                            <field name="imap_failed" invisible="1"/>
                        </group>
                    </group>
                    <field name="body_html" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mail_inbox_search" model="ir.ui.view">
        <field name="name">oski.mail.inbox.search</field>
        <field name="model">oski.mail.inbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="email_from"/>
                <field name="partner_id"/>
                <filter name="filter_new" string="Nouveaux" domain="[('state', '=', 'new')]"/>
                <filter name="filter_answered" string="Répondus" domain="[('state', '=', 'answered')]"/>
                <filter name="filter_done" string="Clos" domain="[('state', '=', 'done')]"/>
                <filter name="filter_spam" string="Indésirables" domain="[('state', '=', 'spam')]"/>
                <separator/>
                <filter name="filter_archived" string="Archivés" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_mailbox" string="Boîte" context="{'group_by': 'mailbox_id'}"/>
                <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_mail_inbox" model="ir.actions.act_window">
        <field name="name">Emails reçus</field>
        <field name="res_model">oski.mail.inbox</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_new': 1, 'search_default_group_mailbox': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun email reçu pour l'instant</p>
            <p>Configurez vos boîtes dans Configuration, la relève est automatique.</p>
        </field>
    </record>
</odoo>
