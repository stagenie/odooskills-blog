<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blocklist_list" model="ir.ui.view">
        <field name="name">oski.mail.blocklist.list</field>
        <field name="model">oski.mail.blocklist</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="email"/>
                <field name="origin_inbox_id" readonly="1"/>
                <field name="blocked_uid" readonly="1"/>
                <field name="blocked_date" readonly="1"/>
                <field name="active" widget="boolean_toggle" groups="oski_mail_inbox.group_manager"/>
            </list>
        </field>
    </record>

    <record id="view_blocklist_search" model="ir.ui.view">
        <field name="name">oski.mail.blocklist.search</field>
        <field name="model">oski.mail.blocklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <filter name="filter_inactive" string="Débloquées"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_blocklist" model="ir.actions.act_window">
        <field name="name">Liste de blocage</field>
        <field name="res_model">oski.mail.blocklist</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune adresse bloquée</p>
            <p>Marquer un email comme indésirable ajoute son expéditeur ici.
               Seul un Manager peut débloquer une adresse.</p>
        </field>
    </record>
</odoo>
