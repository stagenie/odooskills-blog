<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Règles de GROUPE, jamais globales : deux règles globales se combinent
         en ET, ce qui n'élargirait jamais la vue du Manager ; deux règles de
         groupe se combinent en OU, ce qui est le comportement voulu. -->
    <record id="rule_draft_own" model="ir.rule">
        <field name="name">Brouillons : les siens</field>
        <field name="model_id" ref="model_oski_mail_draft"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>

    <record id="rule_draft_manager" model="ir.rule">
        <field name="name">Brouillons : tous, pour le Manager</field>
        <field name="model_id" ref="model_oski_mail_draft"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>
</odoo>
