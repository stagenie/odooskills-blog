<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mail_inbox" model="ir.module.category">
        <field name="name">Messagerie OdooSkills</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_mail_inbox" model="res.groups.privilege">
        <field name="name">Messagerie OdooSkills</field>
        <field name="category_id" ref="module_category_mail_inbox"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="privilege_id" ref="privilege_mail_inbox"/>
        <field name="comment">Lit les emails reçus et y répond.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_mail_inbox"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="comment">Gère les boîtes email et l'import historique.</field>
    </record>
</odoo>
