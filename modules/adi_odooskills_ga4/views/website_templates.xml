<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject GA4 gtag.js into <head> of every public page -->
    <template id="ga4_tracking" inherit_id="website.layout" name="OdooSkills GA4 Tracking">
        <xpath expr="//head" position="inside">
            <t t-set="ga4_id"
               t-value="request.env['ir.config_parameter'].sudo().get_param('odooskills.ga4_measurement_id')"/>
            <t t-if="ga4_id and not editable">
                <!-- Global site tag (gtag.js) - Google Analytics -->
                <script async="async"
                        t-attf-src="https://www.googletagmanager.com/gtag/js?id=#{ga4_id}"/>
                <script>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', '<t t-out="ga4_id"/>');
                </script>
            </t>
        </xpath>
    </template>
</odoo>
