<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 1. Footer : "Powered by Odoo" -> lien d'affiliation          -->
    <!--    Remplace tout le bloc o_brand_promotion (méthode fiable   -->
    <!--    en v19, cf. adi_website_branding).                        -->
    <!-- ============================================================ -->
    <template id="brand_promotion_affiliate" inherit_id="web.brand_promotion"
              name="Footer - Lien affiliation Odoo">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion">
                <t t-set="aff_url"
                   t-value="request.env['ir.config_parameter'].sudo().get_param('oski.odoo_affiliate_url', 'https://www.odoo.com/r/aff-odooskills')"/>
                <span class="small text-muted">
                    Propulsé par
                    <a t-att-href="aff_url" target="_blank"
                       rel="sponsored noopener nofollow" class="text-muted">Odoo</a>
                </span>
            </div>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- 2. Bande CTA en fin d'article + 3. Pastille flottante        -->
    <!--    (position:fixed via SCSS, DOM ici sans importance)        -->
    <!-- ============================================================ -->
    <template id="blog_post_odoo_affiliate" inherit_id="website_blog.blog_post_content"
              name="Blog - CTA affiliation Odoo">
        <xpath expr="//div[@t-field='blog_post.content']" position="after">
            <t t-set="aff_url"
               t-value="request.env['ir.config_parameter'].sudo().get_param('oski.odoo_affiliate_url', 'https://www.odoo.com/r/aff-odooskills')"/>

            <!-- 2. Bande CTA (money spot : lecteur engagé en fin d'article) -->
            <div class="o_oski_aff_band my-4 p-4 rounded text-center">
                <p class="mb-2 fw-bold">🚀 Envie de tester Odoo par vous-même ?</p>
                <p class="mb-3 small o_oski_aff_sub">
                    Créez votre base Odoo gratuitement et explorez toutes les applications.
                </p>
                <a t-att-href="aff_url" target="_blank"
                   rel="sponsored noopener nofollow" class="btn o_oski_aff_btn">
                    Essayer Odoo gratuitement →
                </a>
            </div>

            <!-- 3. Petite pastille flottante persistante (icône seule sur mobile) -->
            <a t-att-href="aff_url" target="_blank" rel="sponsored noopener nofollow"
               class="o_oski_aff_fab" title="Essayer Odoo gratuitement">
                <i class="fa fa-rocket"/>
                <span class="o_oski_aff_fab_txt">Essayer Odoo</span>
            </a>
        </xpath>
    </template>

</odoo>
