<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- URL d'affiliation Odoo. Modifiable dans Paramètres techniques >
         Paramètres système sans redéployer le module. noupdate=1 pour ne
         pas écraser une modification faite en UI lors d'une mise à jour. -->
    <data noupdate="1">
        <record id="param_odoo_affiliate_url" model="ir.config_parameter">
            <field name="key">oski.odoo_affiliate_url</field>
            <field name="value">https://www.odoo.com/r/aff-odooskills</field>
        </record>
    </data>
</odoo>
