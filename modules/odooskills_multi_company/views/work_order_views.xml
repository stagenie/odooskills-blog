<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="work_order_view_list" model="ir.ui.view">
        <field name="name">odooskills.work.order.list</field>
        <field name="model">odooskills.work.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="work_order_view_form" model="ir.ui.view">
        <field name="name">odooskills.work.order.form</field>
        <field name="model">odooskills.work.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="site_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="date_deadline"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="work_order_action" model="ir.actions.act_window">
        <field name="name">Bons d'intervention</field>
        <field name="res_model">odooskills.work.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="work_site_action" model="ir.actions.act_window">
        <field name="name">Sites d'intervention</field>
        <field name="res_model">odooskills.work.site</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_root" name="Interventions" sequence="90"/>
    <menuitem id="menu_work_order" parent="menu_root" action="work_order_action" sequence="10"/>
    <menuitem id="menu_work_site" parent="menu_root" action="work_site_action" sequence="20"/>
</odoo>
