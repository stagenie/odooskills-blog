<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Action de rapport ============ -->
    <record id="action_report_helpdesk_ticket" model="ir.actions.report">
        <field name="name">Fiche ticket</field>
        <field name="model">helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odooskills_helpdesk.report_helpdesk_ticket_document</field>
        <field name="report_file">odooskills_helpdesk.report_helpdesk_ticket_document</field>
        <field name="print_report_name">'Ticket - %s' % (object.reference or object.name)</field>
        <field name="binding_model_id" ref="model_helpdesk_ticket"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============ Template QWeb ============ -->
    <template id="report_helpdesk_ticket_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- En-tête avec référence + badge état -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2 class="mb-1">
                                    Ticket <span t-field="doc.reference"/>
                                </h2>
                                <p class="text-muted mb-0" t-field="doc.name"/>
                            </div>
                            <div class="col-4 text-end">
                                <t t-if="doc.state == 'new'">
                                    <span class="badge rounded-pill" style="background:#17a2b8;color:white;padding:6px 14px;font-size:12px;">Nouveau</span>
                                </t>
                                <t t-elif="doc.state == 'in_progress'">
                                    <span class="badge rounded-pill" style="background:#ffc107;color:#212529;padding:6px 14px;font-size:12px;">En cours</span>
                                </t>
                                <t t-elif="doc.state == 'done'">
                                    <span class="badge rounded-pill" style="background:#28a745;color:white;padding:6px 14px;font-size:12px;">Résolu</span>
                                </t>
                                <p class="small text-muted mt-2 mb-0">
                                    Priorité :
                                    <t t-foreach="range(int(doc.priority or 0))" t-as="i">
                                        <span style="color:#f39c12;">&#9733;</span>
                                    </t>
                                    <t t-if="not int(doc.priority or 0)"><em>Normale</em></t>
                                </p>
                            </div>
                        </div>

                        <!-- Tableau des informations clés -->
                        <table class="table table-sm mb-4">
                            <tr>
                                <th style="width:25%;background:#f6f8fa;">Client</th>
                                <td><span t-field="doc.partner_id"/></td>
                                <th style="width:25%;background:#f6f8fa;">Assigné à</th>
                                <td><span t-field="doc.user_id"/></td>
                            </tr>
                            <tr>
                                <th style="background:#f6f8fa;">Catégorie</th>
                                <td><span t-field="doc.category_id"/></td>
                                <th style="background:#f6f8fa;">Canal</th>
                                <td><span t-field="doc.channel"/></td>
                            </tr>
                            <tr>
                                <th style="background:#f6f8fa;">Créé le</th>
                                <td><span t-field="doc.create_date" t-options='{"widget": "datetime"}'/></td>
                                <th style="background:#f6f8fa;">Échéance</th>
                                <td><span t-field="doc.deadline"/></td>
                            </tr>
                            <tr>
                                <th style="background:#f6f8fa;">SLA</th>
                                <td>
                                    <span t-field="doc.sla_hours"/> h —
                                    <span t-field="doc.sla_status"/>
                                </td>
                                <th style="background:#f6f8fa;">Heures passées</th>
                                <td><span t-field="doc.hours_spent"/> h</td>
                            </tr>
                        </table>

                        <!-- Tags -->
                        <div class="mb-4" t-if="doc.tag_ids">
                            <strong>Étiquettes :</strong>
                            <t t-foreach="doc.tag_ids" t-as="tag">
                                <span class="badge rounded-pill ms-1"
                                      t-attf-style="background:#6c757d;color:white;padding:4px 10px;font-size:11px;">
                                    <t t-out="tag.name"/>
                                </span>
                            </t>
                        </div>

                        <!-- Description -->
                        <h4 class="mt-4 mb-2">Description</h4>
                        <div class="border p-3 mb-4" style="background:#fafafa;min-height:60px;">
                            <span t-field="doc.description"/>
                            <em t-if="not doc.description" class="text-muted">Aucune description.</em>
                        </div>

                        <!-- Note de résolution si résolu -->
                        <div t-if="doc.state == 'done' and doc.resolution_note" class="mb-4">
                            <h4 class="mb-2" style="color:#28a745;">Résolution</h4>
                            <div class="border p-3" style="background:#e8f5e9;white-space:pre-line;">
                                <span t-field="doc.resolution_note"/>
                            </div>
                        </div>

                        <!-- Commentaires -->
                        <div t-if="doc.comment_ids">
                            <h4 class="mt-4 mb-2">Historique des commentaires</h4>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th style="width:20%;">Auteur</th>
                                        <th style="width:60%;">Message</th>
                                        <th style="width:20%;">Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.comment_ids" t-as="comment">
                                        <td><span t-field="comment.author_id"/></td>
                                        <td><span t-field="comment.body"/></td>
                                        <td><span t-field="comment.create_date" t-options='{"widget": "datetime"}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pied de page -->
                        <div class="mt-5 pt-3 border-top text-center text-muted small">
                            <em>Document généré automatiquement — OdooSkills Helpdesk</em>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
