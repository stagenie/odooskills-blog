<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================ Template : ticket ouvert ================ -->
    <record id="mail_template_ticket_opened" model="mail.template">
        <field name="name">Helpdesk : ticket ouvert</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="subject">[{{ object.reference }}] {{ object.name }} — ticket enregistré</field>
        <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="description">Envoyé automatiquement à la création du ticket.</field>
        <field name="body_html" type="html">
<div style="margin:0;font-family:Arial,sans-serif;font-size:14px;color:#212529;">
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>

    <p>Votre demande a bien été enregistrée. Voici un récapitulatif :</p>

    <table style="border-collapse:collapse;width:100%;margin:16px 0;">
        <tr>
            <td style="background:#f6f8fa;padding:8px;width:30%;"><strong>Référence</strong></td>
            <td style="padding:8px;border-bottom:1px solid #dee2e6;"><t t-out="object.reference or ''"/></td>
        </tr>
        <tr>
            <td style="background:#f6f8fa;padding:8px;"><strong>Sujet</strong></td>
            <td style="padding:8px;border-bottom:1px solid #dee2e6;"><t t-out="object.name or ''"/></td>
        </tr>
        <tr>
            <td style="background:#f6f8fa;padding:8px;"><strong>Catégorie</strong></td>
            <td style="padding:8px;border-bottom:1px solid #dee2e6;"><t t-out="object.category_id.display_name or '—'"/></td>
        </tr>
        <tr t-if="object.user_id">
            <td style="background:#f6f8fa;padding:8px;"><strong>Agent en charge</strong></td>
            <td style="padding:8px;border-bottom:1px solid #dee2e6;"><t t-out="object.user_id.name or ''"/></td>
        </tr>
        <tr t-if="object.deadline">
            <td style="background:#f6f8fa;padding:8px;"><strong>Échéance</strong></td>
            <td style="padding:8px;border-bottom:1px solid #dee2e6;"><t t-out="object.deadline"/></td>
        </tr>
    </table>

    <p>Nous vous tiendrons informé dès la résolution. Vous pouvez répondre directement à cet email
       — votre réponse sera automatiquement ajoutée au ticket.</p>

    <p style="margin-top:24px;">Cordialement,<br/>
       <strong>L'équipe support OdooSkills</strong></p>
</div>
        </field>
    </record>

    <!-- ================ Template : ticket résolu ================ -->
    <record id="mail_template_ticket_resolved" model="mail.template">
        <field name="name">Helpdesk : ticket résolu</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="subject">[{{ object.reference }}] Ticket résolu — {{ object.name }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="description">Envoyé automatiquement quand le ticket passe à 'done'.</field>
        <field name="body_html" type="html">
<div style="margin:0;font-family:Arial,sans-serif;font-size:14px;color:#212529;">
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>

    <p>Votre ticket <strong><t t-out="object.reference or ''"/></strong> vient d'être résolu.</p>

    <div style="background:#e8f5e9;border-left:4px solid #28a745;padding:12px 16px;margin:16px 0;">
        <p style="margin:0 0 8px 0;"><strong>Résolution apportée :</strong></p>
        <div style="white-space:pre-line;"><t t-out="object.resolution_note or 'Voir fiche ticket'"/></div>
    </div>

    <p>Si cette résolution ne répond pas à votre attente, répondez simplement à cet email —
       votre message rouvrira automatiquement le ticket.</p>

    <p>Temps total consacré à votre demande : <strong><t t-out="object.hours_spent or 0"/> h</strong>.</p>

    <p style="margin-top:24px;">Cordialement,<br/>
       <strong>L'équipe support OdooSkills</strong></p>
</div>
        </field>
    </record>

</odoo>
