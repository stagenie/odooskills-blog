<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Template de la page publique /helpdesk/status/<ref>
        Utilise web.layout (layout public du site) pour rester cohérent avec website.
    -->
    <template id="ticket_status_page" name="Helpdesk — Suivi de ticket">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container pt-5 pb-5">

                    <div class="row">
                        <div class="col-lg-8 mx-auto">

                            <t t-if="not ticket">
                                <div class="alert alert-warning">
                                    <h3 class="mb-2">Ticket introuvable</h3>
                                    <p class="mb-0">Aucun ticket ne correspond à la référence
                                        <strong><t t-out="ref"/></strong>. Vérifiez votre email de confirmation.</p>
                                </div>
                            </t>

                            <t t-else="">
                                <h1 class="mb-4">Suivi du ticket <t t-out="ticket.reference"/></h1>

                                <div class="card shadow-sm mb-4">
                                    <div class="card-body">
                                        <h4 class="card-title mb-3"><t t-out="ticket.name"/></h4>

                                        <div class="row mb-3">
                                            <div class="col-sm-4 text-muted">Statut</div>
                                            <div class="col-sm-8">
                                                <t t-if="ticket.state == 'new'">
                                                    <span class="badge rounded-pill text-bg-info">Nouveau</span>
                                                </t>
                                                <t t-elif="ticket.state == 'in_progress'">
                                                    <span class="badge rounded-pill text-bg-warning">En cours de traitement</span>
                                                </t>
                                                <t t-elif="ticket.state == 'done'">
                                                    <span class="badge rounded-pill text-bg-success">Résolu</span>
                                                </t>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-4 text-muted">Ouvert le</div>
                                            <div class="col-sm-8">
                                                <span t-field="ticket.create_date" t-options='{"widget": "datetime"}'/>
                                            </div>
                                        </div>

                                        <div class="row mb-3" t-if="ticket.deadline">
                                            <div class="col-sm-4 text-muted">Échéance</div>
                                            <div class="col-sm-8">
                                                <span t-field="ticket.deadline"/>
                                            </div>
                                        </div>

                                        <div class="row mb-3" t-if="ticket.category_id">
                                            <div class="col-sm-4 text-muted">Catégorie</div>
                                            <div class="col-sm-8">
                                                <span t-field="ticket.category_id"/>
                                            </div>
                                        </div>

                                        <div class="row mb-3" t-if="ticket.state == 'done' and ticket.resolved_at">
                                            <div class="col-sm-4 text-muted">Résolu le</div>
                                            <div class="col-sm-8">
                                                <span t-field="ticket.resolved_at" t-options='{"widget": "datetime"}'/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div t-if="ticket.state == 'done' and ticket.resolution_note"
                                     class="alert alert-success">
                                    <h5 class="mb-2">Résolution</h5>
                                    <div style="white-space:pre-line;"><t t-out="ticket.resolution_note"/></div>
                                </div>

                                <p class="text-muted small mt-4">
                                    <i class="fa fa-info-circle" role="img" aria-label="Info"
                                       title="Information"/>
                                    Vous pouvez répondre à l'email de confirmation pour ajouter une
                                    précision — votre message rejoindra automatiquement le ticket.
                                </p>
                            </t>

                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
