<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_helpdesk_ticket_category_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.list</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="arch" type="xml">
            <list string="Catégories">
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_category_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.form</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <notebook>
                        <page string="Sous-catégories" name="children">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_ticket_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">helpdesk.ticket.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
