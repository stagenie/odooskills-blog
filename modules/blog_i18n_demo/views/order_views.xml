<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_blog_i18n_order_form" model="ir.ui.view">
        <field name="name">blog.i18n.order.form</field>
        <field name="model">blog.i18n.order</field>
        <field name="arch" type="xml">
            <form string="Commande de démonstration">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirmer la commande" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- Texte statique QWeb : extrait dans le .pot -->
                    <div class="alert alert-info" role="alert">
                        Bienvenue sur la commande de démonstration.
                    </div>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_blog_i18n_order_list" model="ir.ui.view">
        <field name="name">blog.i18n.order.list</field>
        <field name="model">blog.i18n.order</field>
        <field name="arch" type="xml">
            <list string="Commandes de démonstration">
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_blog_i18n_order" model="ir.actions.act_window">
        <field name="name">Commandes démo i18n</field>
        <field name="res_model">blog.i18n.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_blog_i18n_root" name="Démo i18n"/>
    <menuitem id="menu_blog_i18n_order"
              parent="menu_blog_i18n_root"
              action="action_blog_i18n_order"
              sequence="10"/>

</odoo>
