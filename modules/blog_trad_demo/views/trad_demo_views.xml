<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_trad_demo_product_form" model="ir.ui.view">
        <field name="name">trad.demo.product.form</field>
        <field name="model">trad.demo.product</field>
        <field name="arch" type="xml">
            <form string="Produit vitrine">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trad_demo_product_list" model="ir.ui.view">
        <field name="name">trad.demo.product.list</field>
        <field name="model">trad.demo.product</field>
        <field name="arch" type="xml">
            <list string="Produits vitrine">
                <field name="name"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="action_trad_demo_product" model="ir.actions.act_window">
        <field name="name">Produits vitrine</field>
        <field name="res_model">trad.demo.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_trad_demo_root" name="Démo Traduction"/>
    <menuitem id="menu_trad_demo_product"
              parent="menu_trad_demo_root"
              action="action_trad_demo_product"
              sequence="10"/>

</odoo>
