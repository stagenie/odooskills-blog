<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action rapport QWeb PDF sur le produit vitrine -->
    <record id="action_report_trad_demo_product" model="ir.actions.report">
        <field name="name">Fiche produit</field>
        <field name="model">trad.demo.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">blog_trad_demo.report_trad_demo_product</field>
        <field name="report_file">blog_trad_demo.report_trad_demo_product</field>
        <field name="binding_model_id" ref="model_trad_demo_product"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Gabarit du rapport : libellés statiques (extraits au catalogue) + données t-field (jsonb) -->
    <template id="report_trad_demo_product">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mb-4">Product sheet</h2>
                        <table class="table table-sm">
                            <tr>
                                <th style="width:35%">Name</th>
                                <td><span t-field="doc.name"/></td>
                            </tr>
                            <tr>
                                <th>Internal Reference</th>
                                <td><span t-field="doc.reference"/></td>
                            </tr>
                            <tr>
                                <th>Commercial description</th>
                                <td><span t-field="doc.description"/></td>
                            </tr>
                        </table>
                        <p class="mt-4 text-muted">
                            Document automatically generated by the product catalog.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
