<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_lifecycle" model="ir.ui.view">
        <field name="name">product.template.form.lifecycle</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="ebook_ids" widget="many2many_tags"
                       groups="sales_team.group_sale_manager"/>
                <field name="lifecycle_tier_category_id"
                       groups="sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//field[@name='ebook_ids']" position="after">
                <group string="Tarification OdooSkills" invisible="not ebook_ids"
                       groups="sales_team.group_sale_manager">
                    <field name="oski_is_pack" invisible="1"/>
                    <field name="oski_price_regular"/>
                    <field name="oski_price_launch"/>
                    <field name="oski_launch_deadline"/>
                    <field name="oski_pack_bonus" invisible="not oski_is_pack"/>
                    <button name="action_oski_compute_pack_price" type="object"
                            string="Calculer prix pack" class="btn-secondary"
                            invisible="not oski_is_pack"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
