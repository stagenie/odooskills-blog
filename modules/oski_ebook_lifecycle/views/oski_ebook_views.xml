<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oski_ebook_view_list" model="ir.ui.view">
        <field name="name">oski.ebook.list</field>
        <field name="model">oski.ebook</field>
        <field name="arch" type="xml">
            <list string="Ebooks">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_category_id"/>
                <field name="extract_list_id"/>
            </list>
        </field>
    </record>

    <record id="oski_ebook_view_form" model="ir.ui.view">
        <field name="name">oski.ebook.form</field>
        <field name="model">oski.ebook</field>
        <field name="arch" type="xml">
            <form string="Ebook">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="partner_category_id"/>
                        <field name="extract_list_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oski_ebook_action" model="ir.actions.act_window">
        <field name="name">Ebooks (lifecycle)</field>
        <field name="res_model">oski.ebook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Définir un ebook</p>
            <p>Chaque ebook relie son code (E1, E2…) à une catégorie client et une liste extrait.
               Cochez ensuite les « Ebooks inclus » sur les produits.</p>
        </field>
    </record>

    <menuitem id="menu_oski_ebook"
              name="Ebooks (lifecycle)"
              parent="sale.menu_sale_config"
              action="oski_ebook_action"
              sequence="90"/>
</odoo>
