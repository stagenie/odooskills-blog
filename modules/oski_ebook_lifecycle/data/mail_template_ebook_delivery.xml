<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_ebook_delivery" model="mail.template">
        <field name="name">OdooSkills — Livraison ebook</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="email_from">odooers@odooskills.com</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="subject">Votre formation OdooSkills est prête 🎉</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;color:#1a1a2e;max-width:620px;margin:auto">
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Merci pour votre achat. Vos fichiers sont disponibles immédiatement&#160;:</p>
    <ul>
        <t t-foreach="object.order_line.product_id" t-as="prod">
            <t t-foreach="prod.product_tmpl_id.product_document_ids.filtered(lambda d: d.attached_on_sale == 'sale_order')" t-as="doc">
                <li>
                    <a t-att-href="'%s/web/content/%s?download=true&amp;access_token=%s' % (object.get_base_url(), doc.ir_attachment_id.id, doc.ir_attachment_id.sudo().access_token or '')"
                       t-out="doc.name">Télécharger</a>
                </li>
            </t>
        </t>
    </ul>
    <p>Vous retrouverez aussi un accès permanent à vos fichiers depuis votre compte&#160;:
        <a t-att-href="'%s/my/orders/%s?access_token=%s' % (object.get_base_url(), object.id, object.sudo().access_token or '')">Mon espace OdooSkills</a>.</p>
    <t t-set="code_ebooks" t-value="object.order_line.product_id.product_tmpl_id.ebook_ids.filtered(lambda e: e.code == 'E1')"/>
    <t t-if="code_ebooks">
    <div style="margin-top:20px;padding:16px 18px;background:#f5f3f7;border-left:3px solid #714b67;border-radius:6px">
        <p style="margin:0 0 6px"><strong>Accès au code source et aux corrigés des exercices</strong></p>
        <p style="margin:0 0 6px">Le code des deux modules fil rouge (<code>routeo-vehicle</code>, <code>routeo-rental</code>) et les corrigés des 36 exercices vivent dans des dépôts GitHub <strong>privés</strong>.</p>
        <p style="margin:0">Pour y accéder, envoyez votre identifiant GitHub à <a href="mailto:contact@odooskills.com">contact@odooskills.com</a> (objet «&#160;Accès code Routeo + identifiant GitHub&#160;»). La procédure complète figure en <strong>Annexe A §3</strong> de votre livre&#160;; l'invitation est envoyée généralement sous 24&#160;h ouvrées.</p>
    </div>
    </t>
    <p>Bonne lecture,<br/>L'équipe OdooSkills</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
