<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="offer_page" name="Offre de bienvenue -50%">
        <t t-call="website.layout">
            <div class="container my-5" style="max-width:640px">
                <t t-set="pct" t-value="offer._welcome_percent()"/>
                <t t-if="offer.state in ('active',)">
                    <h1 class="mb-3">Votre remise -<t t-out="pct"/>% est activée&#160;!</h1>
                    <p>Utilisez ce code au moment du paiement&#160;:</p>
                    <p class="display-6 fw-bold" style="letter-spacing:2px"
                       t-out="offer.coupon_id.code"/>
                    <div class="my-4 p-3 rounded text-center"
                         style="background:#f5f6fa;border:1px solid #e4e6ef">
                        <span class="text-muted d-block small">Temps restant</span>
                        <span id="osk_countdown" class="fs-3 fw-bold"
                              t-att-data-deadline="offer.deadline.isoformat()">—</span>
                    </div>
                    <a href="/shop" class="btn btn-primary btn-lg">Choisir mon ebook / pack</a>
                </t>
                <t t-elif="offer.state == 'used'">
                    <h1>Remise déjà utilisée</h1>
                    <p>Cette offre a déjà servi. Merci&#160;! <a href="/shop">Voir la boutique</a></p>
                </t>
                <t t-elif="offer.state == 'expired'">
                    <h1>Offre expirée</h1>
                    <p>Le délai de 72&#160;h est écoulé. <a href="/shop">Voir la boutique au tarif normal</a></p>
                </t>
                <t t-else="">
                    <h1 class="mb-3">Votre remise -<t t-out="pct"/>% vous attend</h1>
                    <p>Cliquez ci-dessous pour démarrer votre compte à rebours de 72&#160;h et révéler votre
                        code de réduction.</p>
                    <form t-attf-action="/oski/offer/{{ offer.token }}/start" method="post" class="mt-4">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary btn-lg">Démarrer ma remise -<t t-out="pct"/>%</button>
                    </form>
                </t>
            </div>
        </t>
    </template>
</odoo>
