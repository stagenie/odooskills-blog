<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CTA réutilisable, rendu seulement si PDF résolu -->
    <template id="pdf_gate_cta" name="CTA téléchargement PDF">
        <t t-set="pdf_url" t-value="blog_post._oski_pdf_download_url()"/>
        <div t-if="pdf_url" class="osk-pdf-gate my-4 p-3 rounded text-center"
             style="background:#eef0fb;border:1px solid #d7dbf5"
             t-att-data-post-id="blog_post.id"
             t-att-data-cover="blog_post._oski_cover_url() or ''">
            <span class="fw-semibold d-block mb-2" style="color:#1a1a2e">
                📄 Emportez cet article en PDF
            </span>
            <button type="button" class="btn btn-primary osk-pdf-btn">
                Télécharger le PDF
            </button>
        </div>
    </template>

    <!-- Injection début + fin du corps -->
    <template id="pdf_gate_inject" inherit_id="website_blog.blog_post_content"
              name="Gate PDF début/fin">
        <xpath expr="//div[@t-field='blog_post.content']" position="before">
            <t t-call="oski_lead_magnet.pdf_gate_cta"/>
        </xpath>
        <xpath expr="//div[@t-field='blog_post.content']" position="after">
            <t t-call="oski_lead_magnet.pdf_gate_cta"/>
        </xpath>
    </template>

    <!-- Modal partagé (rendu une fois dans le layout) -->
    <template id="pdf_gate_modal_inject" inherit_id="website.layout"
              name="Modal gate injection">
        <xpath expr="//footer" position="after">
            <div class="osk-gate-modal" style="display:none" role="dialog"
                 aria-modal="true" aria-labelledby="osk-gate-title">
                <div class="osk-gate-box">
                    <!-- Bandeau habillé par la couverture de l'article ; à défaut,
                         le dégradé défini en CSS prend le relais. -->
                    <div class="osk-gate-cover" aria-hidden="true"/>
                    <button type="button" class="osk-lead-close" aria-label="Fermer">&#215;</button>
                    <div class="osk-gate-icon" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="12" y1="18" x2="12" y2="12"/>
                            <polyline points="9 15 12 18 15 15"/>
                        </svg>
                    </div>
                    <p class="osk-lead-title" id="osk-gate-title">Votre PDF est prêt</p>
                    <p class="osk-lead-sub">Indiquez votre email&#160;: le téléchargement
                       démarre aussitôt et le lien vous est envoyé pour le retrouver plus tard.</p>
                    <form class="osk-gate-form">
                        <input type="email" name="email" placeholder="votre@email.com"
                               autocomplete="email" required="required"/>
                        <label class="osk-lead-consent">
                            <input type="checkbox" name="consent"/>
                            <span>Je souhaite aussi recevoir les nouveaux tutoriels et
                                  guides Odoo d'OdooSkills. Désinscription en un clic.</span>
                        </label>
                        <button type="submit" class="btn btn-primary w-100">Télécharger le PDF</button>
                        <p class="osk-lead-note">Votre PDF vous est envoyé même sans cocher la case.</p>
                        <p class="osk-lead-msg" style="display:none"/>
                    </form>

                    <!-- Écran de confirmation : proposé APRÈS le téléchargement,
                         quand l'internaute a obtenu ce qu'il venait chercher.
                         Le clic sur le bouton est un acte positif explicite,
                         donc un consentement valide. -->
                    <div class="osk-gate-done" style="display:none">
                        <div class="osk-gate-icon osk-gate-icon-ok" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        <p class="osk-lead-title">Votre PDF arrive</p>
                        <p class="osk-lead-sub">Le lien vous a aussi été envoyé par email
                           pour le retrouver plus tard.</p>
                        <div class="osk-gate-optin">
                            <p class="osk-optin-q">Vous voulez les prochains&#160;?</p>
                            <button type="button" class="btn btn-primary w-100 osk-optin-yes">
                                Oui, envoyez-moi les prochains guides
                            </button>
                            <p class="osk-lead-note">Environ un guide par semaine.
                               Désinscription en un clic.</p>
                            <button type="button" class="btn osk-optin-no">Non merci</button>
                        </div>
                        <p class="osk-optin-msg" style="display:none"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
