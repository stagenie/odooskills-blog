<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fiche produit : CTA sous le prix -->
    <template id="product_cta" inherit_id="website_sale.product"
              name="CTA remise inscrit (fiche)">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="after">
            <t t-set="osk_pct" t-value="request.env['oski.welcome.offer'].sudo()._welcome_percent()"/>
            <t t-if="product.oski_price_regular and product.sudo().ebook_ids">
                <div class="osk-price-cta alert alert-info py-2 my-2" role="alert">
                    <span>💡 Abonnez-vous et obtenez <strong>-<t t-out="osk_pct"/>%</strong> :
                        <strong t-out="'%.2f€' % (product.oski_price_regular * (100 - osk_pct) / 100.0)"/></span>
                    <a href="#" class="osk-open-popup btn btn-sm btn-primary ms-2">S'inscrire</a>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Carte catalogue : badge -X% -->
    <template id="products_item_cta" inherit_id="website_sale.products_item"
              name="Badge remise inscrit (carte)">
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="before">
            <t t-set="osk_pct" t-value="request.env['oski.welcome.offer'].sudo()._welcome_percent()"/>
            <t t-if="product.oski_price_regular and product.sudo().ebook_ids">
                <a href="#" class="osk-open-popup badge text-bg-primary text-decoration-none">
                    -<t t-out="osk_pct"/>% si inscrit</a>
            </t>
        </xpath>
    </template>
</odoo>
