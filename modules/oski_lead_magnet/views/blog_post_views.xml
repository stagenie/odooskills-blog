<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blog_post_form_pdf" model="ir.ui.view">
        <field name="name">blog.post.form.oski.pdf</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='author_id']" position="after">
                <field name="oski_pdf_attachment_id"/>
                <field name="oski_pdf_series_id"/>
            </xpath>
        </field>
    </record>
</odoo>
