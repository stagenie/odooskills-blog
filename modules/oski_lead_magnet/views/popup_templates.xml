<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="lead_popup_inject" inherit_id="website.layout" name="Popup lead injection">
        <xpath expr="//footer" position="after">
            <t t-call="oski_lead_magnet.lead_popup"/>
        </xpath>
    </template>

    <template id="lead_popup" name="Popup capture email">
        <t t-set="pct" t-value="request.env['oski.welcome.offer'].sudo()._welcome_percent()"/>
        <div class="osk-lead-popup" t-att-data-percent="pct" style="display:none">
            <button type="button" class="osk-lead-close" aria-label="Fermer">&#215;</button>
            <p class="osk-lead-title">🎁 -<t t-out="pct"/>% pour votre premier achat</p>
            <p class="osk-lead-sub">Inscrivez-vous et obtenez -<t t-out="pct"/>% tout de suite
                (valable 72&#160;h) sur tout ebook ou pack.</p>
            <div class="osk-lead-grid"/>
            <form class="osk-lead-form">
                <input type="email" name="email" placeholder="votre@email.com" required="required"/>
                <label class="osk-lead-consent">
                    <input type="checkbox" name="consent"/>
                    J'accepte de recevoir les offres et nouveautés OdooSkills.
                </label>
                <button type="submit" class="btn btn-primary w-100">Recevoir ma remise</button>
                <p class="osk-lead-msg" style="display:none"/>
            </form>
        </div>
    </template>
</odoo>
