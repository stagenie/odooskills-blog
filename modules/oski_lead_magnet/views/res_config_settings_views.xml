<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.oski.lead.magnet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Offre de bienvenue OdooSkills" name="oski_lead_magnet_block">
                    <setting id="oski_offer_enabled_setting"
                             string="Activer la remise nouveaux inscrits"
                             help="Décochez pour couper complètement la remise de bienvenue : aucun coupon ni email créé, popup et badges -X% masqués. La capture d'email (gate PDF des articles) reste active.">
                        <field name="oski_offer_enabled"/>
                    </setting>
                    <setting id="oski_welcome_percent_setting"
                             string="Remise nouveaux inscrits (%)"
                             help="Remise personnelle offerte aux nouveaux inscrits (email + consentement). Synchronise automatiquement le coupon. Valeur entre 1 et 90.">
                        <field name="oski_welcome_percent"/>
                    </setting>
                    <setting id="oski_offer_hours_setting"
                             string="Validité de l'offre (heures)"
                             help="Durée du compte à rebours déclenché quand l'inscrit clique sur le bouton de l'email de bienvenue.">
                        <field name="oski_offer_hours"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
