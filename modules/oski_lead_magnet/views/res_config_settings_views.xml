<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.oski.lead.magnet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[1]" position="after">
                <block title="Offre de bienvenue OdooSkills" name="oski_lead_magnet_block">
                    <setting string="Remise nouveaux inscrits"
                             help="Remise personnelle offerte aux nouveaux inscrits (email + consentement). Bumper à 50 pour un cas particulier (fin d'année).">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="oski_welcome_percent" class="col-lg-6 o_light_label"/>
                                <field name="oski_welcome_percent"/>
                            </div>
                            <div class="row mt16">
                                <label for="oski_offer_hours" class="col-lg-6 o_light_label"/>
                                <field name="oski_offer_hours"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
