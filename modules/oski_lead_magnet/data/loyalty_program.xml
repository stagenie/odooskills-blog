<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="welcome_program" model="loyalty.program">
        <field name="name">Bienvenue OdooSkills -50%</field>
        <field name="program_type">coupons</field>
        <field name="applies_on">current</field>
        <field name="trigger">with_code</field>
        <field name="portal_visible" eval="False"/>
    </record>

    <record id="welcome_rule" model="loyalty.rule">
        <field name="program_id" ref="welcome_program"/>
        <field name="minimum_amount">0</field>
        <field name="minimum_qty">1</field>
    </record>

    <record id="welcome_reward" model="loyalty.reward">
        <field name="program_id" ref="welcome_program"/>
        <field name="reward_type">discount</field>
        <field name="discount">50</field>
        <field name="discount_mode">percent</field>
        <field name="discount_applicability">order</field>
        <field name="required_points">1</field>
    </record>
</odoo>
