<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_welcome_offer" model="mail.template">
        <field name="name">OdooSkills — Offre de bienvenue -50%</field>
        <field name="model_id" ref="model_oski_welcome_offer"/>
        <field name="subject">Votre remise de bienvenue -50% vous attend</field>
        <field name="email_from">odooers@odooskills.com</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;color:#1a1a2e;max-width:600px;margin:auto">
    <p>Bonjour,</p>
    <p>Merci de rejoindre OdooSkills. Pour bien démarrer, une remise de
       <strong>-50%</strong> sur l'ebook ou le pack de votre choix.</p>
    <p>Attention : le chrono de <strong>72&#160;heures</strong> démarre au moment où
       vous cliquez sur le bouton ci-dessous.</p>
    <p style="text-align:center;margin:28px 0">
        <a t-att-href="'%s/oski/offer/%s' % (object.get_base_url(), object.token)"
           style="background:#635bff;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-weight:bold">
           Profiter de ma remise -50%
        </a>
    </p>
    <p style="font-size:13px;color:#666">Offre personnelle, valable une seule fois.</p>
    <p>— L'équipe OdooSkills</p>
</div>
        </field>
    </record>
</odoo>
