<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST (éditable pour saisie rapide) -->
    <record id="view_affiliate_commission_list" model="ir.ui.view">
        <field name="name">oski.affiliate.commission.list</field>
        <field name="model">oski.affiliate.commission</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date"/>
                <field name="program_id"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="amount_company" widget="monetary" options="{'currency_field': 'company_currency_id'}" sum="Total (devise société)"/>
                <field name="status" widget="badge"
                       decoration-muted="status == 'pending'"
                       decoration-info="status == 'confirmed'"
                       decoration-success="status == 'paid'"/>
                <field name="reference" optional="hide"/>
                <field name="note" optional="hide"/>
                <field name="company_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_affiliate_commission_form" model="ir.ui.view">
        <field name="name">oski.affiliate.commission.form</field>
        <field name="model">oski.affiliate.commission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="program_id"/>
                            <field name="date"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="amount_company" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="reference"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_affiliate_commission_search" model="ir.ui.view">
        <field name="name">oski.affiliate.commission.search</field>
        <field name="model">oski.affiliate.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="program_id"/>
                <field name="reference"/>
                <filter name="pending" string="En attente" domain="[('status', '=', 'pending')]"/>
                <filter name="confirmed" string="Confirmées" domain="[('status', '=', 'confirmed')]"/>
                <filter name="paid" string="Payées" domain="[('status', '=', 'paid')]"/>
                <separator/>
                <filter name="this_year" string="Cette année"
                        domain="[('date', '&gt;=', datetime.date.today().replace(month=1, day=1))]"/>
                <group>
                    <filter name="group_program" string="Programme" context="{'group_by': 'program_id'}"/>
                    <filter name="group_period" string="Période (mois)" context="{'group_by': 'period'}"/>
                    <filter name="group_status" string="Statut" context="{'group_by': 'status'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- PIVOT -->
    <record id="view_affiliate_commission_pivot" model="ir.ui.view">
        <field name="name">oski.affiliate.commission.pivot</field>
        <field name="model">oski.affiliate.commission</field>
        <field name="arch" type="xml">
            <pivot string="Commissions">
                <field name="program_id" type="row"/>
                <field name="period" type="col"/>
                <field name="amount_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH -->
    <record id="view_affiliate_commission_graph" model="ir.ui.view">
        <field name="name">oski.affiliate.commission.graph</field>
        <field name="model">oski.affiliate.commission</field>
        <field name="arch" type="xml">
            <graph string="Commissions" type="bar">
                <field name="period"/>
                <field name="amount_company" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_affiliate_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">oski.affiliate.commission</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Saisissez vos commissions</p>
            <p>Chaque commission encaissée, saisie manuellement, alimente vos statistiques.</p>
        </field>
    </record>
</odoo>
