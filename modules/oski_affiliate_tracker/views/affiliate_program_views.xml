<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM -->
    <record id="view_affiliate_program_form" model="ir.ui.view">
        <field name="name">oski.affiliate.program.form</field>
        <field name="model">oski.affiliate.program</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                    <button name="action_open_dashboard" type="object" string="Ouvrir le tableau de bord"
                            class="btn-secondary" icon="fa-external-link"
                            invisible="not dashboard_url"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_commissions" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="commission_count" widget="statinfo" string="Commissions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Fermé" bg_color="text-bg-danger"
                            invisible="status != 'closed'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. Amazon Associates"/></h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </div>
                    <group>
                        <group string="Général">
                            <field name="site"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="commission_model"/>
                            <field name="default_rate"/>
                        </group>
                        <group string="Statistiques">
                            <field name="total_earned" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="total_pending" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="total_paid" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="last_commission_date"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Compte &amp; accès" name="account">
                            <group>
                                <group string="Connexion">
                                    <field name="login_username"/>
                                    <field name="credentials_ref"
                                           placeholder="Ex. Bitwarden &gt; Amazon"/>
                                    <field name="contact_email" widget="email"/>
                                </group>
                                <group string="Liens">
                                    <field name="signup_url" widget="url"/>
                                    <field name="dashboard_url" widget="url"/>
                                    <field name="referral_link" widget="url"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert">
                                Ne saisissez jamais un mot de passe en clair. Utilisez
                                « Emplacement du mot de passe » pour pointer vers votre coffre.
                            </div>
                        </page>
                        <page string="Liens d'affiliation" name="links">
                            <field name="link_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="url" widget="url"/>
                                    <field name="campaign"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Ajoutez ici tous vos liens affiliés pour ce programme
                                (par article, bannière, campagne…). Le lien principal reste
                                dans l'onglet « Compte &amp; accès ».
                            </p>
                        </page>
                        <page string="Paiement" name="payment">
                            <group>
                                <field name="payment_method"/>
                                <field name="payout_threshold"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_affiliate_program_list" model="ir.ui.view">
        <field name="name">oski.affiliate.program.list</field>
        <field name="model">oski.affiliate.program</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="site"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="commission_count"/>
                <field name="total_earned" widget="monetary" options="{'currency_field': 'company_currency_id'}" sum="Total gagné"/>
                <field name="total_pending" widget="monetary" options="{'currency_field': 'company_currency_id'}" sum="En attente"/>
                <field name="last_commission_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'paused'"
                       decoration-danger="status == 'closed'"/>
                <field name="company_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- KANBAN -->
    <record id="view_affiliate_program_kanban" model="ir.ui.view">
        <field name="name">oski.affiliate.program.kanban</field>
        <field name="model">oski.affiliate.program</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="company_currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span class="float-end">
                                    <field name="status" widget="label_selection"
                                           options="{'classes': {'active': 'success', 'paused': 'warning', 'closed': 'danger'}}"/>
                                </span>
                            </div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <div class="mt-2">
                                <span class="text-muted">Total gagné : </span>
                                <strong><field name="total_earned" widget="monetary" options="{'currency_field': 'company_currency_id'}"/></strong>
                            </div>
                            <div>
                                <span class="text-muted">En attente : </span>
                                <field name="total_pending" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_affiliate_program_search" model="ir.ui.view">
        <field name="name">oski.affiliate.program.search</field>
        <field name="model">oski.affiliate.program</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="site"/>
                <field name="tag_ids"/>
                <filter name="active_status" string="Actifs" domain="[('status', '=', 'active')]"/>
                <filter name="paused_status" string="En pause" domain="[('status', '=', 'paused')]"/>
                <group>
                    <filter name="group_status" string="Statut" context="{'group_by': 'status'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_affiliate_program" model="ir.actions.act_window">
        <field name="name">Programmes</field>
        <field name="res_model">oski.affiliate.program</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajoutez votre premier programme d'affiliation</p>
            <p>Centralisez vos programmes, vos accès et vos commissions.</p>
        </field>
    </record>
</odoo>
