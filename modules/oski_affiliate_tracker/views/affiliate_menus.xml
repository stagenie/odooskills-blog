<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Config: catégories -->
    <record id="view_affiliate_tag_list" model="ir.ui.view">
        <field name="name">oski.affiliate.tag.list</field>
        <field name="model">oski.affiliate.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_affiliate_tag" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">oski.affiliate.tag</field>
        <field name="view_mode">list</field>
    </record>

    <!-- App root -->
    <menuitem id="menu_affiliate_root" name="Affiliations"
              web_icon="oski_affiliate_tracker,static/description/icon.png"
              sequence="55"/>

    <menuitem id="menu_affiliate_programs" name="Programmes"
              parent="menu_affiliate_root" action="action_affiliate_program" sequence="10"/>

    <menuitem id="menu_affiliate_commissions" name="Commissions"
              parent="menu_affiliate_root" action="action_affiliate_commission" sequence="20"/>

    <menuitem id="menu_affiliate_config" name="Configuration"
              parent="menu_affiliate_root" sequence="90"/>

    <menuitem id="menu_affiliate_tags" name="Catégories"
              parent="menu_affiliate_config" action="action_affiliate_tag" sequence="10"/>
</odoo>
