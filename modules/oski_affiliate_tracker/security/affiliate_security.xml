<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_oski_affiliate_manager" model="res.groups">
        <field name="name">Gestionnaire d'affiliations</field>
    </record>

    <!-- Tout utilisateur interne accède à l'app (outil perso mono/multi-utilisateur) -->
