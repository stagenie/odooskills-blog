<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action : report_name pointe vers le template ; le modèle Python
         report.<report_name> fournira les données via _get_report_values. -->
    <record id="action_report_sales_summary" model="ir.actions.report">
        <field name="name">Synthèse des ventes</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odooskills_report_dynamic_demo.report_sales_summary</field>
        <field name="report_file">odooskills_report_dynamic_demo.report_sales_summary</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Template : consomme summary / grand_total calculés en Python.
         Une seule page de synthèse pour l'ensemble des commandes choisies. -->
    <template id="report_sales_summary">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="docs[:1]"/>
                <t t-set="layout_document_title">Synthèse des ventes</t>
                <div class="page">
                    <p class="text-muted">
                        Synthèse portant sur <span t-out="len(docs)"/> commande(s),
                        agrégée par catégorie de produit.
                    </p>

                    <table class="table table-sm mt-3" style="border-top:2px solid #d6336c;">
                        <thead>
                            <tr>
                                <th>Catégorie</th>
                                <th class="text-end">Quantité</th>
                                <th class="text-end">Total HT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="summary" t-as="row">
                                <td><span t-out="row['category']"/></td>
                                <td class="text-end"><span t-out="'%.2f' % row['qty']"/></td>
                                <td class="text-end"><span t-out="'%.2f' % row['subtotal']"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Total général</th>
                                <th/>
                                <th class="text-end"><span t-out="'%.2f' % grand_total"/></th>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="row mt-4">
                        <div class="col-8">
                            <p class="small text-muted">
                                Scanne le QR code pour vérifier cette synthèse en ligne.
                            </p>
                        </div>
                        <div class="col-4 text-end">
                            <img t-att-src="'/report/barcode/QR/%s' % ('https://odooskills.com/verifier/%s' % docs[0].name)"
                                 style="width:110px;height:110px;"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
