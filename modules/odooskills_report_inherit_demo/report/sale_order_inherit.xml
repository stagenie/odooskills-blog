<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Héritage du rapport de devis / commande de vente.
        Cible : sale.report_saleorder_document
        (odoo/addons/sale/report/ir_actions_report_templates.xml)
        ⚠️ La variable de boucle ici s'appelle `doc` (et non `o`).
        Le rapport Pro forma (sale.report_saleorder_pro_forma) réutilise ce même
        document : l'héritage profite donc aussi à la pro forma, sans code en plus.
    -->
    <template id="report_saleorder_document_oski"
              inherit_id="sale.report_saleorder_document">

        <!-- Rappel de validité de l'offre, ajouté après le bloc d'informations -->
        <xpath expr="//div[@id='informations']" position="after">
            <div t-if="doc.validity_date" class="oski-quote-note mt-2 mb-3 p-2"
                 style="border-left:3px solid #d6336c;background:#fdf2f6;border-radius:3px">
                Offre valable jusqu'au <span t-field="doc.validity_date"/>.
            </div>
        </xpath>

    </template>

</odoo>
