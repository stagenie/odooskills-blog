<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Héritage du rapport de facture standard.
        Cible : account.report_invoice_document (odoo/addons/account/views/report_invoice.xml)
        Trois techniques xpath : before / attributes / after.
        Les styles sont posés en `style="..."` inline : un rapport PDF est rendu par
        wkhtmltopdf, qui lit parfaitement les styles inline sans dépendre d'un bundle.
    -->
    <template id="report_invoice_document_oski"
              inherit_id="account.report_invoice_document">

        <!-- 1) position="before" : bandeau d'échéance juste avant le tableau des lignes -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <div t-if="o.move_type == 'out_invoice' and o.invoice_date_due"
                 class="oski-due-banner mb-3 p-2"
                 style="border-left:3px solid #d6336c;background:#fdf2f6;border-radius:3px">
                <span class="fw-bold">Échéance de paiement :</span>
                <span t-field="o.invoice_date_due"/>
            </div>
        </xpath>

        <!-- 2) position="attributes" : on ajoute une classe au tableau des lignes -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class" add="oski-lines" separator=" "/>
        </xpath>

        <!-- 3) position="after" : encadré mentions + coordonnées bancaires après les totaux -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="oski-invoice-footer mt-4 p-3"
                 style="border:1px solid #e9ecef;border-top:3px solid #d6336c;border-radius:4px;background:#fbfbfc;font-size:0.9em">
                <p class="mb-1 fw-bold">Merci de votre confiance.</p>
                <p class="mb-1">
                    Tout règlement est à effectuer à l'ordre de
                    <span t-field="o.company_id.name"/>.
                </p>
                <p t-if="o.partner_bank_id" class="mb-0">
                    <span class="fw-bold">IBAN :</span>
                    <span t-field="o.partner_bank_id.acc_number"/>
                </p>
            </div>
        </xpath>

    </template>

</odoo>
