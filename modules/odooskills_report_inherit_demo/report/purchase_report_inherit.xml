<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Héritage du bon de commande fournisseur.
        Cible : purchase.report_purchaseorder_document
        (odoo/addons/purchase/report/purchase_order_templates.xml) — variable `o`.
    -->
    <template id="report_purchaseorder_document_oski"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- Rappel de contact achats après les totaux -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="oski-po-note mt-3 p-2"
                 style="border-left:3px solid #d6336c;background:#fdf2f6;border-radius:3px">
                Merci d'accuser réception de cette commande par retour de courriel à
                <span t-field="o.user_id.email" t-if="o.user_id.email"/>
                <span t-else="">notre service achats</span>.
            </div>
        </xpath>

    </template>

    <!--
        Héritage de la demande de prix (RFQ).
        Cible : purchase.report_purchasequotation_document
        (odoo/addons/purchase/report/purchase_quotation_templates.xml) — variable `o`.
    -->
    <template id="report_purchasequotation_document_oski"
              inherit_id="purchase.report_purchasequotation_document">

        <!-- Consigne de réponse en pied de page -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="oski-rfq-note mt-4 p-2"
                 style="border-left:3px solid #d6336c;background:#fdf2f6;border-radius:3px">
                Merci de nous retourner votre meilleure offre, prix et délais inclus.
            </div>
        </xpath>

    </template>

</odoo>
