<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mig_demo_item_list" model="ir.ui.view">
        <field name="name">mig.demo.item.list</field>
        <field name="model">mig.demo.item</field>
        <field name="arch" type="xml">
            <list string="Items démo migration">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_mig_demo_item_form" model="ir.ui.view">
        <field name="name">mig.demo.item.form</field>
        <field name="model">mig.demo.item</field>
        <field name="arch" type="xml">
            <form string="Item démo migration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mig_demo_item" model="ir.actions.act_window">
        <field name="name">Items démo migration</field>
        <field name="res_model">mig.demo.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mig_demo_root"
              name="Migration Demo"
              sequence="100"/>
    <menuitem id="menu_mig_demo_items"
              name="Items"
              parent="menu_mig_demo_root"
              action="action_mig_demo_item"
              sequence="10"/>
</odoo>
