<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="parcours_page" name="Parcours de lecture">
        <t t-call="website.layout">
            <t t-set="additional_title">Parcours de lecture</t>
            <div id="wrap" class="o_oski_parcours">
                <section class="container py-5">
                    <h1 class="mb-2">Parcours de lecture</h1>
                    <p class="lead text-muted mb-4">
                        Chaque série se lit dans l'ordre : commencez par la première étape, les suivantes s'appuient dessus.
                    </p>
                    <ul t-if="len(tabs) &gt; 1" class="nav nav-pills mb-4">
                        <li t-foreach="tabs" t-as="tab" class="nav-item">
                            <a t-attf-href="/parcours/#{tab.slug}"
                               t-attf-class="nav-link #{'active' if tab == version else ''}"
                               t-out="tab.name"/>
                        </li>
                    </ul>
                    <p t-if="not sections" class="text-muted">
                        Aucun parcours n'est encore publié pour cette version.
                    </p>
                    <section t-foreach="sections" t-as="section" class="mb-5"
                             t-attf-id="blog-#{section['blog'].id}">
                        <h2 class="h3 mb-4" t-out="section['blog'].name"/>
                        <article t-foreach="section['series']" t-as="entry" class="card mb-4"
                                 t-attf-id="serie-#{entry['series'].id}">
                            <div class="card-body">
                                <h3 class="h5 card-title mb-1" t-out="entry['series'].name"/>
                                <p class="small mb-2">
                                    <span class="badge text-bg-light border"
                                          t-out="entry['series'].odoo_version_id.name or 'Toutes versions'"/>
                                    <span t-if="entry['series'].audience" class="text-muted ms-2"
                                          t-out="entry['series'].audience"/>
                                </p>
                                <p t-if="entry['series'].description" class="mb-3"
                                   t-out="entry['series'].description"/>
                                <ol class="mb-0">
                                    <t t-foreach="entry['rows']" t-as="row">
                                        <li t-if="row['block']" class="d-block fw-semibold mt-3 mb-1"
                                            t-out="row['block']"/>
                                        <li><a t-att-href="row['post'].website_url" t-out="row['post'].name"/></li>
                                    </t>
                                </ol>
                            </div>
                        </article>
                        <div t-if="section['independents']" class="mt-4">
                            <h3 class="h6 text-uppercase text-muted">Articles indépendants récents</h3>
                            <ul class="mb-2">
                                <li t-foreach="section['independents']" t-as="post">
                                    <a t-att-href="post.website_url" t-out="post.name"/>
                                </li>
                            </ul>
                        </div>
                        <a t-attf-href="/blog/#{slug(section['blog'])}">Tous les articles de ce blog →</a>
                    </section>
                </section>
            </div>
        </t>
    </template>
</odoo>
