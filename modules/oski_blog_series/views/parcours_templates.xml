<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="parcours_chooser" name="Parcours de lecture — choix du profil">
        <t t-call="website.layout">
            <t t-set="additional_title">Parcours de lecture</t>
            <div id="wrap" class="o_oski_parcours">
                <section class="container py-5">
                    <h1 class="mb-2">Parcours de lecture</h1>
                    <p class="lead text-muted mb-4">
                        Choisissez votre profil : chaque parcours se lit dans l'ordre, étape par étape.
                    </p>
                    <p t-if="not cards" class="text-muted">
                        Aucun parcours n'est encore publié.
                    </p>
                    <div t-if="cards" class="row g-4">
                        <div t-foreach="cards" t-as="card" class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <h2 class="h4 card-title" t-out="card['blog'].name"/>
                                    <p class="card-text text-muted"
                                       t-out="card['blog'].parcours_teaser or card['blog'].subtitle"/>
                                    <p class="small mb-3">
                                        <t t-out="'1 parcours' if card['series_count'] == 1 else '%d parcours' % card['series_count']"/>
                                        · <t t-out="'1 article' if card['post_count'] == 1 else '%d articles' % card['post_count']"/>
                                    </p>
                                    <a t-att-href="card['url']" class="btn btn-primary mt-auto">Voir les parcours →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="parcours_profile" name="Parcours de lecture — profil">
        <t t-call="website.layout">
            <t t-set="additional_title">Parcours de lecture</t>
            <div id="wrap" class="o_oski_parcours">
                <section class="container py-5">
                    <a href="/parcours" class="d-inline-block mb-3">← Tous les profils</a>
                    <h1 class="mb-1">Parcours de lecture</h1>
                    <p class="lead text-muted mb-4" t-out="blog.name"/>
                    <ul t-if="len(tabs) &gt; 1" class="nav nav-pills mb-4">
                        <li t-foreach="tabs" t-as="tab" t-if="tab.slug" class="nav-item">
                            <a t-att-href="blog._oski_parcours_url(tab)"
                               t-attf-class="nav-link #{'active' if tab == version else ''}"
                               t-out="tab.name"/>
                        </li>
                    </ul>
                    <p t-if="not entries" class="text-muted">
                        Aucun parcours n'est encore publié pour cette version.
                    </p>
                    <article t-foreach="entries" t-as="entry" class="card mb-4"
                             t-attf-id="serie-#{entry['series'].id}">
                        <div class="card-body">
                            <h3 class="h5 card-title mb-1" t-out="entry['series'].name"/>
                            <p class="small mb-2">
                                <span class="badge text-bg-light border"
                                      t-out="entry['series'].odoo_version_id.name or 'Toutes versions'"/>
                                <span t-if="entry['series'].audience" class="text-muted ms-2"
                                      t-out="entry['series'].audience"/>
                            </p>
                            <p t-if="entry['series'].description" class="mb-3"
                               t-out="entry['series'].description"/>
                            <ol class="mb-0">
                                <t t-foreach="entry['rows']" t-as="row">
                                    <li t-if="row['block']" class="d-block fw-semibold mt-3 mb-1"
                                        t-out="row['block']"/>
                                    <li><a t-att-href="row['post'].website_url" t-out="row['post'].name"/></li>
                                </t>
                            </ol>
                        </div>
                    </article>
                    <div t-if="independents" class="mt-4">
                        <h3 class="h6 text-uppercase text-muted">Articles indépendants récents</h3>
                        <ul class="mb-2">
                            <li t-foreach="independents" t-as="post">
                                <a t-att-href="post.website_url" t-out="post.name"/>
                            </li>
                        </ul>
                    </div>
                    <a t-attf-href="/blog/#{slug(blog)}" class="d-block mb-3">Tous les articles de ce blog →</a>
                    <div t-if="other_cards" class="mt-4">
                        <a t-foreach="other_cards" t-as="other" t-att-href="other['url']" class="d-block">
                            Autre profil : <t t-out="other['blog'].name"/> →
                        </a>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
