<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bandeau en tête de la liste d'un blog qui a des parcours -->
    <template id="blog_list_parcours_banner" name="Bandeau parcours (liste du blog)"
              inherit_id="website_blog.blog_post_short">
        <xpath expr="//t[@t-call='website_blog.posts_loop']" position="before">
            <div t-if="blog and not tag and not date_begin and not search and blog.parcours_slug and blog._oski_has_parcours()"
                 class="o_oski_parcours_banner alert alert-info mb-4">
                <a t-att-href="blog._oski_parcours_url()" class="alert-link">Nouveau ici ? Suivez un parcours dans l'ordre →</a>
            </div>
        </xpath>
    </template>

    <!-- Repère de série entre la couverture et le corps de l'article -->
    <template id="blog_post_series_badge" name="Repère de série (article)"
              inherit_id="website_blog.blog_post_complete">
        <xpath expr="//section[@id='o_wblog_post_main']" position="before">
            <t t-set="oski_badge" t-value="blog_post._oski_series_badge()"/>
            <div t-if="oski_badge" class="o_oski_series_badge container pt-3">
                <p class="mb-1 small">
                    Série <strong t-out="oski_badge['series'].name"/>
                    · étape <t t-out="oski_badge['step']"/>/<t t-out="oski_badge['total']"/>
                    <!-- RULING I3 : pas de lien si le blog de la série n'a pas d'adresse
                         de parcours (url alors False, il n'y a pas de page à ouvrir). -->
                    <t t-if="oski_badge['url']"> · <a t-att-href="oski_badge['url']">Voir tout le parcours →</a></t>
                </p>
                <p t-if="oski_badge['newer'] and oski_badge['newer_url']" class="mb-0 small text-muted">
                    <t t-if="oski_badge['series'].odoo_version_id">Écrit pour <t t-out="oski_badge['series'].odoo_version_id.name"/> · </t>
                    <a t-att-href="oski_badge['newer_url']">Une édition <t t-out="oski_badge['newer'].odoo_version_id.name or 'plus récente'"/> de ce parcours existe →</a>
                </p>
            </div>
        </xpath>
    </template>

    <!-- Navigation dans la série, après le corps de l'article -->
    <template id="blog_post_series_nav" name="Navigation de série (article)"
              inherit_id="website_blog.blog_post_complete">
        <xpath expr="//section[@id='o_wblog_post_footer']" position="before">
            <!-- `o_wblog_post_main` précède toujours `o_wblog_post_footer` dans l'arch
                 parente `website_blog.blog_post_complete` : `oski_badge` (calculé par
                 `blog_post_series_badge`) est donc déjà posé ici. On le réutilise plutôt
                 que de rappeler `_oski_series_badge()` une seconde fois pour la même
                 page. Couplage volontaire entre les deux gabarits de ce module : si
                 `blog_post_series_badge` était un jour désactivé seul, `oski_badge`
                 vaudrait None et cette navigation ne s'afficherait simplement plus. -->
            <t t-set="oski_nav" t-value="oski_badge"/>
            <nav t-if="oski_nav" class="o_oski_series_nav container my-4" aria-label="Navigation dans la série">
                <div class="d-flex flex-wrap justify-content-between gap-3 border-top pt-3">
                    <div class="flex-fill">
                        <a t-if="oski_nav['prev']" t-att-href="oski_nav['prev'].website_url" class="d-block text-decoration-none">
                            <span class="small text-muted d-block">← Étape précédente</span>
                            <span t-out="oski_nav['prev'].name"/>
                        </a>
                    </div>
                    <div class="flex-fill text-end">
                        <a t-if="oski_nav['next']" t-att-href="oski_nav['next'].website_url" class="d-block text-decoration-none">
                            <span class="small text-muted d-block">Étape suivante →</span>
                            <span t-out="oski_nav['next'].name"/>
                        </a>
                        <span t-else="" class="small text-muted">Dernière étape de la série</span>
                    </div>
                </div>
                <p t-if="oski_nav['url']" class="text-center small mt-2 mb-0">
                    <a t-att-href="oski_nav['url']">Voir tout le parcours →</a>
                </p>
            </nav>
        </xpath>
    </template>

    <!-- « Read Next » d'Odoo (vue optionnelle, active par défaut) : masqué sur les articles de série.
         Il montre l'article d'id inférieur (ordre `id DESC` du contrôleur), le plus souvent l'étape
         PRÉCÉDENTE, juste sous « Étape suivante → » de la navigation de série. Réutilise `oski_badge`
         posé par `blog_post_series_badge` (même couplage que `blog_post_series_nav`) : sans repère de
         série, `oski_badge` vaut None et « Read Next » reste affiché comme avant. -->
    <template id="blog_post_read_next_hidden_in_series" name="Read Next masqué dans une série"
              inherit_id="website_blog.opt_blog_post_read_next">
        <xpath expr="//div[@t-if='next_post']" position="attributes">
            <attribute name="t-if">next_post and not oski_badge</attribute>
        </xpath>
    </template>
</odoo>
