<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog : adresse et accroche du parcours -->
    <record id="view_blog_blog_form_oski_parcours" model="ir.ui.view">
        <field name="name">blog.blog.form.oski.parcours</field>
        <field name="model">blog.blog</field>
        <field name="inherit_id" ref="website_blog.view_blog_blog_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="after">
                <field name="parcours_slug"/>
                <field name="parcours_teaser"/>
            </xpath>
        </field>
    </record>

    <!-- Versions d'Odoo -->
    <record id="view_oski_blog_odoo_version_list" model="ir.ui.view">
        <field name="name">oski.blog.odoo.version.list</field>
        <field name="model">oski.blog.odoo.version</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="slug"/>
                <field name="is_current"/>
            </list>
        </field>
    </record>

    <record id="action_oski_blog_odoo_version" model="ir.actions.act_window">
        <field name="name">Versions d'Odoo</field>
        <field name="res_model">oski.blog.odoo.version</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Séries -->
    <record id="view_oski_blog_series_list" model="ir.ui.view">
        <field name="name">oski.blog.series.list</field>
        <field name="model">oski.blog.series</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="blog_id"/>
                <field name="odoo_version_id"/>
                <field name="tag_id"/>
                <field name="audience" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_oski_blog_series_form" model="ir.ui.view">
        <field name="name">oski.blog.series.form</field>
        <field name="model">oski.blog.series</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex. Reprendre ses données"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="blog_id"/>
                            <field name="odoo_version_id" placeholder="Toutes versions"/>
                            <field name="tag_id"/>
                        </group>
                        <group>
                            <field name="audience" placeholder="Ex. Débutant · développeur"/>
                            <field name="replaced_by_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Une ou deux phrases affichées sur /parcours"/>
                    <notebook>
                        <page name="posts" string="Articles">
                            <field name="post_ids">
                                <list editable="bottom" create="0" delete="0" default_order="series_position, post_date, id">
                                    <field name="series_position" widget="handle"/>
                                    <field name="name" readonly="1"/>
                                    <field name="series_block"/>
                                    <field name="is_published" readonly="1"/>
                                    <field name="post_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oski_blog_series_search" model="ir.ui.view">
        <field name="name">oski.blog.series.search</field>
        <field name="model">oski.blog.series</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="blog_id"/>
                <field name="odoo_version_id"/>
                <filter string="Archivées" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Blog" name="group_by_blog" context="{'group_by': 'blog_id'}"/>
                    <filter string="Version d'Odoo" name="group_by_version" context="{'group_by': 'odoo_version_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oski_blog_series" model="ir.actions.act_window">
        <field name="name">Séries</field>
        <field name="res_model">oski.blog.series</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_blog': 1}</field>
    </record>

    <!-- Articles : onglet, filtre, colonne -->
    <record id="view_blog_post_form_oski_series" model="ir.ui.view">
        <field name="name">blog.post.form.oski.series</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="oski_series" string="Série">
                    <group>
                        <field name="series_id"/>
                        <field name="series_position" invisible="not series_id"/>
                        <field name="series_block" invisible="not series_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_blog_post_search_oski_series" model="ir.ui.view">
        <field name="name">blog.post.search.oski.series</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Sans série" name="oski_no_series" domain="[('series_id', '=', False)]"/>
                <field name="series_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_blog']" position="after">
                <filter string="Série" name="oski_group_by_series" context="{'group_by': 'series_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_blog_post_list_oski_series" model="ir.ui.view">
        <field name="name">blog.post.list.oski.series</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="after">
                <field name="series_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_oski_blog_series" name="Séries" parent="website_blog.menu_website_blog_root_global"
              action="action_oski_blog_series" sequence="25"/>
    <menuitem id="menu_oski_blog_odoo_version" name="Versions d'Odoo" parent="website_blog.menu_website_blog_root_global"
              action="action_oski_blog_odoo_version" sequence="45"/>
</odoo>
