<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_xlsx_chart_export" model="ir.ui.view">
        <field name="name">sale.order.form.xlsx.chart.export</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_lines_xlsx_chart" type="object"
                        string="Exporter en Excel (graphiques)" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
