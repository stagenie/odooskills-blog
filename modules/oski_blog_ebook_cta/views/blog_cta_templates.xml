<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Carte CTA réutilisable -->
    <template id="ebook_cta_band" name="Bande CTA Ebook">
        <t t-set="cta_products" t-value="blog_post._get_ebook_cta_products()"/>
        <t t-set="cta_edition_20" t-value="blog_post._get_ebook_cta_edition_20_available()"/>
        <div t-if="cta_products" class="o_oski_ebook_cta my-4 p-4 rounded"
             style="background:#f5f6fa;border:1px solid #e4e6ef">
            <p class="mb-3 fw-bold" style="color:#1a1a2e">
                📘 Pour aller plus loin : nos formations Odoo
            </p>
            <div class="d-flex flex-column flex-md-row gap-3">
                <t t-foreach="cta_products" t-as="prod">
                    <a t-att-href="prod.oski_hub_url or prod.website_url"
                       class="d-flex align-items-center text-decoration-none flex-grow-1 p-2 rounded bg-white"
                       style="border:1px solid #e4e6ef">
                        <img t-att-src="'/web/image/product.template/%s/image_128' % prod.id"
                             class="me-3 rounded" style="width:48px;height:64px;object-fit:cover"
                             t-att-alt="prod.name"/>
                        <span>
                            <span class="d-block fw-semibold" style="color:#1a1a2e" t-out="prod.name"/>
                            <span class="small text-primary">Découvrir →</span>
                        </span>
                    </a>
                </t>
            </div>
            <p t-if="cta_edition_20" class="small mt-3 mb-0" style="color:#4a4a5e">
                Cet article a été écrit pour Odoo 19. L'édition Odoo 20 de nos formations est disponible :
                <a href="/formations">voir la gamme Odoo 20</a>.
            </p>
        </div>
    </template>

    <!-- Injection en fin de corps d'article, avant les tags -->
    <template id="blog_post_content_cta" inherit_id="website_blog.blog_post_content">
        <xpath expr="//div[@t-field='blog_post.content']" position="after">
            <t t-if="blog_post.is_published and 'data-oski-ebook-cta' not in (blog_post.content or '')" t-call="oski_blog_ebook_cta.ebook_cta_band"/>
        </xpath>
    </template>
</odoo>
