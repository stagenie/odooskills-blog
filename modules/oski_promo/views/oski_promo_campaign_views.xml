<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_campaign_list" model="ir.ui.view">
    <field name="name">oski.promo.campaign.list</field>
    <field name="model">oski.promo.campaign</field>
    <field name="arch" type="xml">
        <list string="Campagnes promotionnelles"
              decoration-success="state == 'running'"
              decoration-muted="state == 'done'">
            <field name="name"/>
            <field name="label_public"/>
            <field name="date_start"/>
            <field name="date_end"/>
            <field name="discount_percent"/>
            <field name="state"/>
        </list>
    </field>
</record>

<record id="view_campaign_form" model="ir.ui.view">
    <field name="name">oski.promo.campaign.form</field>
    <field name="model">oski.promo.campaign</field>
    <field name="arch" type="xml">
        <form string="Campagne promotionnelle">
            <header>
                <button name="action_generate_lines" type="object"
                        string="Générer les lignes" class="btn-secondary"
                        invisible="applied"/>
                <button name="action_apply" type="object"
                        string="Appliquer" class="btn-primary"
                        invisible="applied"/>
                <button name="action_cancel" type="object"
                        string="Annuler la campagne" class="btn-secondary"
                        invisible="not applied"
                        confirm="Les prix promotionnels seront retirés du site. Continuer ?"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,scheduled,running,done"/>
            </header>
            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="label_public"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="discount_percent"/>
                        <field name="applied" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Produits" name="lines">
                        <field name="line_ids" readonly="applied">
                            <list editable="bottom">
                                <field name="product_tmpl_id"/>
                                <field name="price_regular"/>
                                <field name="price_current"/>
                                <field name="price_promo"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="action_campaign" model="ir.actions.act_window">
    <field name="name">Campagnes promotionnelles</field>
    <field name="res_model">oski.promo.campaign</field>
    <field name="view_mode">list,form</field>
</record>

<!-- website.menu_website_configuration est la RACINE de l'app Site Web, pas
     son menu Configuration : sans restriction de groupe, l'entrée serait
     visible par tout utilisateur interne alors que l'ACL du modèle
     n'accorde l'accès qu'à base.group_system — soit une AccessError au
     clic. Le groupe posé ici aligne la visibilité sur les droits réels. -->
<menuitem id="menu_campaign_root" name="Promotions OdooSkills"
          parent="website.menu_website_configuration"
          groups="base.group_system"
          action="action_campaign" sequence="90"/>

</odoo>
