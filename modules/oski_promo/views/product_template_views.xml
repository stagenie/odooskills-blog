<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Sans cet onglet, les champs de présentation du hub existent en base
     mais restent hors de portée : ajouter un ebook au catalogue
     repasserait par un script, ce que ce lot cherche précisément à
     supprimer. Les champs sont groupés avec les prix EUR du module
     lifecycle, sur la page « Site web » de la fiche produit. -->
<record id="view_product_template_hub_form" model="ir.ui.view">
    <field name="name">product.template.form.oski.hub</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="website_sale.product_template_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='sales']" position="inside">
            <group string="Hub des formations" name="oski_hub"
                   invisible="not ebook_ids">
                <field name="oski_hub_kicker" placeholder="Technique"/>
                <field name="oski_hub_title"
                       placeholder="Vide : le nom du produit"/>
                <field name="oski_hub_specs"
                       placeholder="Vide : la description de vente"/>
                <field name="oski_hub_color" placeholder="#1F7A43"/>
                <field name="oski_hub_url"
                       placeholder="Vide : la fiche boutique"/>
            </group>
        </xpath>
    </field>
</record>

</odoo>
