<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="countdown" name="Compte à rebours OdooSkills">
    <span class="oski-countdown">
        <span class="oski-countdown-label" t-out="info['label']"/>
        <span class="oski-countdown-clock">—</span>
    </span>
</template>

<template id="price_block" name="Bloc tarif OdooSkills">
    <t t-set="info" t-value="website.oski_price(sku)"/>
    <span class="oski-price"
          t-att-data-oski-price="sku"
          t-att-data-after="info['after_fmt']"
          t-att-data-deadline="info['deadline_iso'] or None">
        <span class="oski-price-strike" t-if="info['barre'] &gt; info['payer']">
            <t t-out="info['barre_fmt']"/> €
        </span>
        <span class="oski-price-pay"><t t-out="info['payer_fmt']"/> €</span>
        <t t-if="info['promo']">
            <t t-call="oski_promo.countdown"/>
        </t>
    </span>
</template>

</odoo>
