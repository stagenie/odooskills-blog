<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="countdown" name="Compte à rebours OdooSkills">
    <span class="oski-countdown">
        <span class="oski-countdown-label" t-out="info['label']"/>
        <span class="oski-countdown-clock">—</span>
    </span>
</template>

<template id="price_block" name="Bloc tarif OdooSkills">
    <t t-set="info" t-value="website.oski_price(sku)"/>
    <span class="oski-price"
          t-att-data-oski-price="sku"
          t-att-data-after="info['after_fmt']"
          t-att-data-deadline="info['deadline_iso'] or None">
        <span class="oski-price-strike" t-if="info['barre'] &gt; info['payer']">
            <t t-out="info['barre_fmt']"/> €
        </span>
        <span class="oski-price-pay"><t t-out="info['payer_fmt']"/> €</span>
        <t t-if="info['promo']">
            <t t-call="oski_promo.countdown"/>
        </t>
    </span>
</template>

<template id="banner" name="Bandeau promotion OdooSkills">
    <t t-set="campaign" t-value="website.oski_running_campaign()"/>
    <div t-if="campaign" class="oski-promo-banner"
         t-att-data-deadline="campaign.oski_deadline_iso()">
        <span class="oski-promo-banner-label" t-out="campaign.label_public"/>
        <span class="oski-promo-banner-clock">—</span>
    </div>
</template>

<template id="banner_in_layout" inherit_id="website.layout"
          name="Bandeau promotion OdooSkills (injection)">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
        <t t-call="oski_promo.banner"/>
    </xpath>
</template>

</odoo>
