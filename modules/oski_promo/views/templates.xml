<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="countdown" name="Compte à rebours OdooSkills">
    <span class="oski-countdown">
        <span class="oski-countdown-label" t-out="info['label']"/>
        <span class="oski-countdown-clock">—</span>
    </span>
</template>

<template id="price_block" name="Bloc tarif OdooSkills">
    <t t-set="info" t-value="website.oski_price(sku)"/>
    <span class="oski-price"
          t-att-data-oski-price="sku"
          t-att-data-after="info['after_fmt']"
          t-att-data-barre="info['barre']"
          t-att-data-after-value="info['after']"
          t-att-data-deadline="info['deadline_iso'] or None">
        <span class="oski-price-strike" t-if="info['barre'] &gt; info['payer']">
            <t t-out="info['barre_fmt']"/> €
        </span>
        <span class="oski-price-pay"><t t-out="info['payer_fmt']"/> €</span>
        <t t-if="info['promo']">
            <t t-call="oski_promo.countdown"/>
        </t>
    </span>
</template>

<template id="banner" name="Bandeau promotion OdooSkills">
    <t t-set="campaign" t-value="website.oski_running_campaign()"/>
    <div t-if="campaign" class="oski-promo-banner"
         t-att-data-deadline="campaign.oski_deadline_iso()">
        <span class="oski-promo-banner-label" t-out="campaign.label_public"/>
        <span class="oski-promo-banner-clock">—</span>
    </div>
</template>

<template id="banner_in_layout" inherit_id="website.layout"
          name="Bandeau promotion OdooSkills (injection)">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
        <t t-call="oski_promo.banner"/>
    </xpath>
</template>

<template id="landing_skeleton" name="Squelette de landing OdooSkills">
    <!-- Dupliquer ce template pour une nouvelle formation.
         Remplacer les textes ; ne JAMAIS écrire de montant :
         chaque prix passe par oski_promo.price_block.

         ÉTAPE OBLIGATOIRE À LA DUPLICATION — poser la référence produit en
         tête de la page, juste sous la balise racine du template :

             <t t-set="sku" t-value="'EBOOK-E4'"/>

         C'est elle que price_block lit. Sans elle, oski_price() reçoit une
         référence vide, rend son dict neutre, et la page affiche un tarif
         à blanc au lieu du prix réel. La ligne est déjà en place ci-dessous
         Aucune valeur par défaut n'est posée ici volontairement : un repli
         silencieux afficherait le prix d'une AUTRE formation, ce qui est
         pire qu'un tarif à blanc. -->
    <div class="oski-landing">
        <section class="oski-landing-hero">
            <h1>Titre de la formation</h1>
            <p class="lead">Promesse en une phrase.</p>
            <div class="oski-landing-cta">
                <t t-call="oski_promo.price_block"/>
                <a href="/shop" class="btn btn-primary">Obtenir la formation</a>
            </div>
        </section>

        <section class="oski-landing-content">
            <h2>Ce que vous saurez faire</h2>
            <p>Contenu à rédiger.</p>
        </section>

        <section class="oski-landing-closing">
            <h2>Commander</h2>
            <t t-call="oski_promo.price_block"/>
            <a href="/shop" class="btn btn-primary">Obtenir la formation</a>
        </section>
    </div>
</template>

</odoo>
