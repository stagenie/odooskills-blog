<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loyalty_reward_view_form_oski" model="ir.ui.view">
        <field name="name">loyalty.reward.view.form.oski.net.price</field>
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_form"/>
        <field name="arch" type="xml">
            <field name="discount_max_amount" position="after">
                <field name="oski_net_price"
                       invisible="discount_applicability != 'specific' or discount_mode != 'percent'"/>
            </field>
        </field>
    </record>

    <record id="loyalty_card_view_form_oski" model="ir.ui.view">
        <field name="name">loyalty.card.view.form.oski.partner</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="oski_partner_id"/>
            </field>
        </field>
    </record>

    <record id="loyalty_card_view_tree_oski" model="ir.ui.view">
        <field name="name">loyalty.card.view.list.oski.partner</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="oski_partner_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="loyalty_card_view_search_oski" model="ir.ui.view">
        <field name="name">loyalty.card.view.search.oski.partner</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="oski_partner_id"/>
            </field>
        </field>
    </record>

    <record id="view_partner_form_oski_coupon" model="ir.ui.view">
        <field name="name">res.partner.view.form.oski.coupon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page name="oski_coupons" string="Codes personnels"
                      invisible="not oski_coupon_ids">
                    <group>
                        <field name="oski_coupon_code"/>
                        <field name="oski_coupon_label"/>
                        <field name="oski_coupon_price_fmt"/>
                        <field name="oski_coupon_expiration"/>
                    </group>
                    <field name="oski_coupon_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="program_id"/>
                            <field name="points_display" string="Solde"/>
                            <field name="expiration_date"/>
                            <field name="order_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
