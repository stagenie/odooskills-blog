<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Graph view : inscrits par jour -->
    <record id="view_mailing_contact_analytics_graph" model="ir.ui.view">
        <field name="name">mailing.contact.analytics.graph</field>
        <field name="model">mailing.contact</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph string="Nouveaux inscrits par jour" sample="1" type="bar">
                <field name="create_date" interval="day" type="row"/>
                <field name="id" type="measure" string="Inscrits"/>
            </graph>
        </field>
    </record>

    <!-- Graph view : inscrits par pays -->
    <record id="view_mailing_contact_analytics_graph_country" model="ir.ui.view">
        <field name="name">mailing.contact.analytics.graph.country</field>
        <field name="model">mailing.contact</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph string="Inscrits par pays" sample="1" type="bar">
                <field name="country_id" type="row"/>
                <field name="id" type="measure" string="Inscrits"/>
            </graph>
        </field>
    </record>

    <!-- List view : détail inscrits -->
    <record id="view_mailing_contact_analytics_list" model="ir.ui.view">
        <field name="name">mailing.contact.analytics.list</field>
        <field name="model">mailing.contact</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Nouveaux inscrits" create="0" delete="0" edit="0" default_order="create_date desc">
                <field name="create_date"/>
                <field name="name"/>
                <field name="email"/>
                <field name="country_id"/>
                <field name="list_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Search view : filtres temps + groupements -->
    <record id="view_mailing_contact_analytics_search" model="ir.ui.view">
        <field name="name">mailing.contact.analytics.search</field>
        <field name="model">mailing.contact</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Filtres analytics">
                <field name="name"/>
                <field name="email"/>
                <field name="country_id"/>
                <field name="list_ids"/>
                <separator/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('create_date','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_7d" string="7 derniers jours"
                        domain="[('create_date','&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="Ce mois"
                        domain="[('create_date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Mois dernier"
                        domain="[('create_date','&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),('create_date','&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_30d" string="30 derniers jours"
                        domain="[('create_date','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_by_day" string="Jour"
                            context="{'group_by': 'create_date:day'}"/>
                    <filter name="group_by_month" string="Mois"
                            context="{'group_by': 'create_date:month'}"/>
                    <filter name="group_by_country" string="Pays"
                            context="{'group_by': 'country_id'}"/>
                    <filter name="group_by_list" string="Liste de diffusion"
                            context="{'group_by': 'list_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action : Inscrits par jour -->
    <record id="action_blog_analytics_subscribers" model="ir.actions.act_window">
        <field name="name">Inscrits — Par jour</field>
        <field name="res_model">mailing.contact</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_mailing_contact_analytics_graph"/>
        <field name="search_view_id" ref="view_mailing_contact_analytics_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_by_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pas encore d'inscrits sur cette période</p>
            <p>Les nouveaux abonnés newsletter apparaissent ici dès leur opt-in.</p>
        </field>
    </record>

    <!-- Action : Inscrits par pays -->
    <record id="action_blog_analytics_subscribers_by_country" model="ir.actions.act_window">
        <field name="name">Inscrits — Par pays</field>
        <field name="res_model">mailing.contact</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_mailing_contact_analytics_graph_country"/>
        <field name="search_view_id" ref="view_mailing_contact_analytics_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_by_country': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun pays détecté</p>
            <p>Le module adi_blog_geoip résout automatiquement le pays à l'inscription.</p>
        </field>
    </record>
</odoo>
