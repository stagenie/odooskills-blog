<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view : visiteurs uniques avec pays + totaux en footer -->
    <record id="view_website_visitor_analytics_list" model="ir.ui.view">
        <field name="name">website.visitor.analytics.list</field>
        <field name="model">website.visitor</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Visiteurs &amp; Pays" create="0" delete="0" edit="0"
                  default_order="last_connection_datetime desc">
                <field name="country_id"/>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="lang_id" optional="show"/>
                <field name="visit_count" sum="Total visites"/>
                <field name="visitor_page_count" sum="Total pages vues"/>
                <field name="last_connection_datetime" string="Dernière visite"/>
                <field name="create_date" string="Première visite" optional="hide"/>
                <field name="website_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Graph view : visiteurs par pays -->
    <record id="view_website_visitor_analytics_graph" model="ir.ui.view">
        <field name="name">website.visitor.analytics.graph</field>
        <field name="model">website.visitor</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph string="Visiteurs par pays" sample="1" type="bar">
                <field name="country_id" type="row"/>
                <field name="visit_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot view : pays × mesure (visites + pages) -->
    <record id="view_website_visitor_analytics_pivot" model="ir.ui.view">
        <field name="name">website.visitor.analytics.pivot</field>
        <field name="model">website.visitor</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- visitor_page_count exclu des mesures : champ calculé non stocké
                 (compute _compute_page_statistics, sans aggregator) → impossible
                 à agréger par read_group côté serveur (pivot). visit_count est stocké. -->
            <pivot string="Visiteurs &amp; Pays" sample="1">
                <field name="country_id" type="row"/>
                <field name="visit_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search view : filtres temps + pays -->
    <record id="view_website_visitor_analytics_search" model="ir.ui.view">
        <field name="name">website.visitor.analytics.search</field>
        <field name="model">website.visitor</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Filtres visiteurs">
                <field name="country_id"/>
                <field name="partner_id"/>
                <field name="lang_id"/>
                <separator/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('last_connection_datetime','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_7d" string="7 derniers jours"
                        domain="[('last_connection_datetime','&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="Ce mois"
                        domain="[('last_connection_datetime','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Mois dernier"
                        domain="[('last_connection_datetime','&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),('last_connection_datetime','&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_30d" string="30 derniers jours"
                        domain="[('last_connection_datetime','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="with_country" string="Avec pays détecté"
                        domain="[('country_id','!=', False)]"/>
                <filter name="without_country" string="Sans pays"
                        domain="[('country_id','=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_by_country" string="Pays"
                            context="{'group_by': 'country_id'}"/>
                    <filter name="group_by_lang" string="Langue"
                            context="{'group_by': 'lang_id'}"/>
                    <filter name="group_by_day_last" string="Jour (dernière visite)"
                            context="{'group_by': 'last_connection_datetime:day'}"/>
                    <filter name="group_by_month_last" string="Mois (dernière visite)"
                            context="{'group_by': 'last_connection_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action : Visiteurs &amp; Pays -->
    <record id="action_blog_analytics_visitors_by_country" model="ir.actions.act_window">
        <field name="name">Visiteurs &amp; Pays</field>
        <field name="res_model">website.visitor</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="view_website_visitor_analytics_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_by_country': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun visiteur sur cette période</p>
            <p>Chaque visiteur unique est enregistré dans <code>website.visitor</code> avec son pays (géoloc IP).
               Le champ <code>visit_count</code> compte les sessions, <code>visitor_page_count</code> les pages vues.</p>
        </field>
    </record>
</odoo>
