<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Application root menu (apparaît dans la grille Apps backend) -->
    <menuitem id="menu_blog_analytics_root"
              name="Blog Analytics"
              web_icon="adi_blog_analytics,static/description/icon.png"
              groups="adi_blog_analytics.group_blog_analytics_viewer"
              sequence="85"/>

    <!-- Sous-menu Inscrits (catégorie) -->
    <menuitem id="menu_blog_analytics_subscribers_root"
              name="Inscrits"
              parent="menu_blog_analytics_root"
              sequence="10"/>

    <menuitem id="menu_blog_analytics_subscribers_by_day"
              name="Par jour"
              parent="menu_blog_analytics_subscribers_root"
              action="action_blog_analytics_subscribers"
              sequence="10"/>

    <menuitem id="menu_blog_analytics_subscribers_by_country"
              name="Par pays"
              parent="menu_blog_analytics_subscribers_root"
              action="action_blog_analytics_subscribers_by_country"
              sequence="20"/>

    <!-- Vues d'articles -->
    <menuitem id="menu_blog_analytics_pageviews"
              name="Vues d'articles"
              parent="menu_blog_analytics_root"
              action="action_blog_analytics_pageviews"
              sequence="20"/>

    <!-- Top articles -->
    <menuitem id="menu_blog_analytics_top_posts"
              name="Top articles"
              parent="menu_blog_analytics_root"
              action="action_blog_analytics_top_posts"
              sequence="30"/>
</odoo>
