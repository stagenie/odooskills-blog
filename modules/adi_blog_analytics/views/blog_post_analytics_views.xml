<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view : top articles ordonnés -->
    <record id="view_blog_post_analytics_list" model="ir.ui.view">
        <field name="name">blog.post.analytics.list</field>
        <field name="model">blog.post</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Top articles" create="0" delete="0" edit="0" default_order="visits desc">
                <field name="name"/>
                <field name="blog_id"/>
                <field name="visits" string="Vues totales"/>
                <field name="post_date"/>
                <field name="author_id"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="is_published" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Graph view : top 10 par visits -->
    <record id="view_blog_post_analytics_graph" model="ir.ui.view">
        <field name="name">blog.post.analytics.graph</field>
        <field name="model">blog.post</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph string="Top articles (vues)" sample="1" type="bar">
                <field name="name" type="row"/>
                <field name="visits" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search view : filtres top articles -->
    <record id="view_blog_post_analytics_search" model="ir.ui.view">
        <field name="name">blog.post.analytics.search</field>
        <field name="model">blog.post</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Filtres top articles">
                <field name="name"/>
                <field name="blog_id"/>
                <field name="tag_ids"/>
                <field name="author_id"/>
                <separator/>
                <filter name="published" string="Publiés"
                        domain="[('is_published', '=', True)]"/>
                <filter name="this_month_posted" string="Postés ce mois"
                        domain="[('post_date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month_posted" string="Postés mois dernier"
                        domain="[('post_date','&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),('post_date','&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group string="Regrouper par">
                    <filter name="group_by_blog" string="Blog"
                            context="{'group_by': 'blog_id'}"/>
                    <filter name="group_by_author" string="Auteur"
                            context="{'group_by': 'author_id'}"/>
                    <filter name="group_by_month_posted" string="Mois publication"
                            context="{'group_by': 'post_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action : Top articles -->
    <record id="action_blog_analytics_top_posts" model="ir.actions.act_window">
        <field name="name">Top articles</field>
        <field name="res_model">blog.post</field>
        <field name="view_mode">list,graph</field>
        <field name="view_id" ref="view_blog_post_analytics_list"/>
        <field name="search_view_id" ref="view_blog_post_analytics_search"/>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun article publié</p>
            <p>Les articles sont triés par nombre de vues décroissant. Le champ `visits` est natif Odoo (blog.post.visits).</p>
        </field>
    </record>
</odoo>
