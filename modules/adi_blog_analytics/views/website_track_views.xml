<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Graph view : vues par jour -->
    <record id="view_website_track_analytics_graph" model="ir.ui.view">
        <field name="name">website.track.analytics.graph</field>
        <field name="model">website.track</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <graph string="Vues d'articles blog par jour" sample="1" type="line">
                <field name="visit_datetime" interval="day" type="row"/>
                <field name="id" type="measure" string="Vues"/>
            </graph>
        </field>
    </record>

    <!-- List view : détail des hits -->
    <record id="view_website_track_analytics_list" model="ir.ui.view">
        <field name="name">website.track.analytics.list</field>
        <field name="model">website.track</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Vues d'articles" create="0" delete="0" edit="0" default_order="visit_datetime desc">
                <field name="visit_datetime"/>
                <field name="visitor_id"/>
                <field name="url"/>
                <field name="page_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Search view : filtres temps (adaptés à visit_datetime) -->
    <record id="view_website_track_analytics_search" model="ir.ui.view">
        <field name="name">website.track.analytics.search</field>
        <field name="model">website.track</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Filtres vues articles">
                <field name="url"/>
                <field name="visitor_id"/>
                <separator/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('visit_datetime','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_7d" string="7 derniers jours"
                        domain="[('visit_datetime','&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="Ce mois"
                        domain="[('visit_datetime','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Mois dernier"
                        domain="[('visit_datetime','&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),('visit_datetime','&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_30d" string="30 derniers jours"
                        domain="[('visit_datetime','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_by_day" string="Jour"
                            context="{'group_by': 'visit_datetime:day'}"/>
                    <filter name="group_by_url" string="URL"
                            context="{'group_by': 'url'}"/>
                    <filter name="group_by_visitor" string="Visiteur"
                            context="{'group_by': 'visitor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action : Vues d'articles blog -->
    <record id="action_blog_analytics_pageviews" model="ir.actions.act_window">
        <field name="name">Vues d'articles</field>
        <field name="res_model">website.track</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_website_track_analytics_graph"/>
        <field name="search_view_id" ref="view_website_track_analytics_search"/>
        <field name="domain">[('url', 'like', '/blog/%')]</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_by_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune vue d'article sur cette période</p>
            <p>Chaque page d'article blog visitée est traquée dans website.track (filtré /blog/%).</p>
        </field>
    </record>
</odoo>
