<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege (regroupement v19 — remplace category_id sur res.groups) -->
    <record id="privilege_blog_analytics" model="res.groups.privilege">
        <field name="name">Blog Analytics</field>
        <field name="sequence">85</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_blog_analytics_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_blog_analytics"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Accès lecture seule au tableau de bord Blog Analytics (inscrits, vues d'articles, top articles).</field>
    </record>
</odoo>
