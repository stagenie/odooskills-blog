<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action de rapport : pilote OÙ et POUR QUI la sortie apparaît.
         - binding_model_id  : rattache la sortie au modèle sale.order
         - binding_type      : 'report' => entrée du menu Imprimer (pas du menu Action)
         - binding_view_types: 'list,form' => visible en liste ET en fiche
         - group_ids         : seuls les vendeurs voient l'entrée
         - domain            : n'apparaît que sur les commandes confirmées
         - print_report_name : nom de fichier dynamique -->
    <record id="action_report_order_followup" model="ir.actions.report">
        <field name="name">Fiche de suivi</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odooskills_print_output_demo.report_order_followup</field>
        <field name="report_file">odooskills_print_output_demo.report_order_followup</field>
        <field name="print_report_name">'Suivi - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain">[('state', '=', 'sale')]</field>
    </record>

    <!-- Template multi-documents : la boucle docs imprime toutes les commandes
         sélectionnées dans un seul PDF (une page chacune via page-break). -->
    <template id="report_order_followup">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Suivi de commande <span t-field="doc.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Client</strong>
                                <div t-field="doc.partner_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Statut</strong>
                                <div t-field="doc.state"/>
                                <div>Confirmée le <span t-field="doc.date_order"/></div>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th class="text-end">Qté</th>
                                    <th class="text-end">Total HT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.order_line" t-as="line">
                                    <td><span t-field="line.product_id"/></td>
                                    <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row justify-content-end mt-3">
                            <div class="col-4 text-end">
                                <strong>Total TTC : </strong>
                                <span t-field="doc.amount_total"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
