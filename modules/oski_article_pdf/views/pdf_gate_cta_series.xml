<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Libellé du CTA adapté aux séries : oski_article_pdf est propriétaire de
         oski.pdf.series.post_ids (One2many ajouté par ce module), donc c'est ici
         — et non dans oski_lead_magnet, qui ignore post_ids — que le gabarit
         générique doit être étendu. -->
    <template id="pdf_gate_cta_series" inherit_id="oski_lead_magnet.pdf_gate_cta"
              name="CTA téléchargement PDF (libellé série)">
        <xpath expr="//span[hasclass('fw-semibold')]" position="before">
            <t t-set="serie" t-value="blog_post.oski_pdf_series_id"/>
            <t t-set="nb" t-value="len(serie.post_ids) if serie else 0"/>
        </xpath>
        <xpath expr="//span[hasclass('fw-semibold')]" position="replace">
            <span class="fw-semibold d-block mb-2" style="color:#1a1a2e">
                📄 <t t-if="serie">Emportez toute la série en PDF</t>
                   <t t-else="">Emportez cet article en PDF</t>
            </span>
        </xpath>
        <xpath expr="//button[hasclass('osk-pdf-btn')]" position="replace">
            <button type="button" class="btn btn-primary osk-pdf-btn">
                <t t-if="serie">Obtenir les <t t-out="nb"/> articles en PDF</t>
                <t t-else="">Obtenir cet article en PDF</t>
            </button>
        </xpath>
    </template>
</odoo>
