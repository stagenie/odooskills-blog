<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_code_client" model="ir.ui.view">
        <field name="name">res.partner.form.code.client</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="before">
                <label for="oski_code" string="Code client"/>
                <div class="o_row">
                    <field name="oski_code" placeholder="Pas encore de code"/>
                    <button name="action_oski_generer_code" type="object" string="Générer le code"
                            class="btn-secondary btn-sm" invisible="oski_code"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
