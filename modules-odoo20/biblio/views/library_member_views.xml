<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Adhérents">
                <field name="card_number"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="join_date"/>
                <field name="loan_count"/>
                <field name="late_loan_count" decoration-danger="late_loan_count &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="library_member_view_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Adhérent">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object"
                                class="oe_stat_button" icon="book_5">
                            <field name="loan_count" widget="statinfo" string="Emprunts"/>
                        </button>
                        <button name="action_view_late_loans" type="object"
                                class="oe_stat_button" icon="schedule"
                                invisible="late_loan_count == 0">
                            <field name="late_loan_count" widget="statinfo" string="Retards"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom de l'adhérent"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Adhésion">
                            <field name="card_number"/>
                            <field name="join_date"/>
                        </group>
                        <group string="Coordonnées">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="city"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_member_action" model="ir.actions.act_window">
        <field name="name">Adhérents</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inscrire un premier adhérent</p>
            <p>Un adhérent est une personne du carnet d'adresses, munie d'une carte.</p>
        </field>
    </record>

    <menuitem id="library_menu_member" name="Adhérents" parent="library_menu_root"
              action="library_member_action" sequence="30"/>

</odoo>
