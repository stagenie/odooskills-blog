<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_breadcrumbs_loans" inherit_id="portal.portal_breadcrumbs" name="Fil d'Ariane : emprunts">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'library_loan'" t-attf-class="breadcrumb-item #{'' if loan else 'active'}">
                <a t-if="loan" href="/my/loans">Mes emprunts</a>
                <t t-else="">Mes emprunts</t>
            </li>
            <li t-if="loan" class="breadcrumb-item active">
                <t t-out="loan.reference"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_loans" name="Mes emprunts">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">Mes emprunts</h3>
            <div t-if="not loans" class="alert alert-info" role="alert">
                Vous n'avez aucun emprunt.
            </div>
            <t t-if="loans" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Référence</th>
                        <th>Livre</th>
                        <th>Emprunté le</th>
                        <th>À rendre le</th>
                        <th class="text-end">État</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="loans" t-as="loan">
                        <td><a t-att-href="loan.access_url" t-out="loan.reference"/></td>
                        <td t-out="loan.book_id.title"/>
                        <td><span t-field="loan.date_out"/></td>
                        <td>
                            <span t-field="loan.date_due"/>
                            <span t-if="loan.is_late" class="badge text-bg-danger ms-1">En retard</span>
                        </td>
                        <td class="text-end"><span t-field="loan.state"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_my_loan" name="Mon emprunt">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Emprunt <t t-out="loan.reference"/></h4>
                    <span t-if="loan.is_late" class="badge text-bg-danger">
                        En retard de <t t-out="loan.days_late"/> jour(s)
                    </span>
                    <span t-else="" class="badge text-bg-secondary" t-field="loan.state"/>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Livre</dt>
                        <dd class="col-sm-8" t-out="loan.book_id.title"/>
                        <dt class="col-sm-4">Exemplaire</dt>
                        <dd class="col-sm-8" t-out="loan.copy_id.name"/>
                        <dt class="col-sm-4">Emprunté le</dt>
                        <dd class="col-sm-8"><span t-field="loan.date_out"/></dd>
                        <dt class="col-sm-4">À rendre le</dt>
                        <dd class="col-sm-8"><span t-field="loan.date_due"/></dd>
                        <t t-if="loan.date_return">
                            <dt class="col-sm-4">Rendu le</dt>
                            <dd class="col-sm-8"><span t-field="loan.date_return"/></dd>
                        </t>
                    </dl>
                </div>
            </div>
        </t>
    </template>

</odoo>
