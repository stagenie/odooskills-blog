<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_loan_export_view_form" model="ir.ui.view">
        <field name="name">library.loan.export.form</field>
        <field name="model">library.loan.export</field>
        <field name="arch" type="xml">
            <form string="Exporter les emprunts">
                <field name="state" invisible="1"/>
                <field name="file_name" invisible="1"/>
                <group invisible="state != 'choose'">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="scope" widget="radio"/>
                    </group>
                </group>
                <div invisible="state != 'get'">
                    <p><field name="loan_count" class="oe_inline" readonly="1"/> emprunt(s) dans le classeur :</p>
                    <p><field name="file_data" readonly="1" filename="file_name"/></p>
                </div>
                <footer invisible="state != 'choose'">
                    <button name="action_generate" type="object" string="Générer le classeur" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
                <footer invisible="state != 'get'">
                    <button name="action_download" type="object" string="Télécharger" class="btn-primary"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="library_loan_export_action" model="ir.actions.act_window">
        <field name="name">Exporter les emprunts</field>
        <field name="res_model">library.loan.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="library_menu_report" name="Rapports" parent="library_menu_root" sequence="80"/>
    <menuitem id="library_menu_loan_export" name="Emprunts (Excel)" parent="library_menu_report"
              action="library_loan_export_action" sequence="10"/>

</odoo>
