<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_loan_view_list" model="ir.ui.view">
        <field name="name">library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list string="Emprunts" decoration-danger="is_late">
                <field name="reference"/>
                <field name="copy_id"/>
                <field name="member_id"/>
                <field name="date_out"/>
                <field name="date_due"/>
                <field name="date_return"/>
                <field name="days_late"/>
                <field name="reminder_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="library_loan_view_search" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search string="Emprunts">
                <field name="reference"/>
                <field name="member_id"/>
                <field name="copy_id"/>
                <filter name="filter_late" string="En retard" domain="[('is_late', '=', True)]"/>
                <filter name="filter_ongoing" string="En cours" domain="[('state', '=', 'ongoing')]"/>
                <separator/>
                <filter name="filter_due" string="Échéance" date="date_due"/>
                <group>
                    <filter name="group_member" string="Adhérent" context="{'group_by': 'member_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_book" string="Livre" context="{'group_by': 'book_id'}"/>
                    <filter name="group_genre" string="Genre" context="{'group_by': 'genre_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_loan_view_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Emprunt">
                <header>
                    <button name="action_return" type="object" string="Marquer comme rendu"
                            class="btn-primary" invisible="state == 'returned'"/>
                    <button name="action_send_reminder" type="object" string="Relancer par courriel"
                            invisible="not is_late"/>
                    <button name="action_print_loan" type="object" string="Imprimer la fiche"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Emprunt">
                            <field name="copy_id"/>
                            <field name="member_id"/>
                        </group>
                        <group string="Dates">
                            <field name="date_out"/>
                            <field name="duration"/>
                            <field name="date_due"/>
                            <field name="date_return" invisible="state != 'returned'"/>
                        </group>
                        <group string="Retard" invisible="not is_late">
                            <field name="is_late"/>
                            <field name="days_late"/>
                            <field name="reminder_count"/>
                            <field name="reminder_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="library_loan_view_card" model="ir.ui.view">
        <field name="name">library.loan.card</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <card>
                <field name="is_late"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <field name="reference" class="fw-bold fs-5"/>
                            <field name="copy_id" class="text-muted"/>
                            <footer>
                                <field name="member_id" widget="many2one_avatar"/>
                                <div class="ms-auto">
                                    <span t-if="record.is_late.raw_value" class="badge text-bg-danger">
                                        <field name="days_late"/> j de retard
                                    </span>
                                    <field t-else="" name="date_due"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </card>
        </field>
    </record>

    <record id="library_loan_view_kanban" model="ir.ui.view">
        <field name="name">library.loan.kanban</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <kanban card_id="%(library_loan_view_card)d" default_group_by="state" quick_create="0"/>
        </field>
    </record>

    <record id="library_loan_view_graph" model="ir.ui.view">
        <field name="name">library.loan.graph</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <graph string="Emprunts par mois" type="bar" stacked="1">
                <field name="date_out" interval="month"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="library_loan_view_pivot" model="ir.ui.view">
        <field name="name">library.loan.pivot</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des emprunts">
                <field name="genre_ids" type="row"/>
                <field name="state" type="col"/>
                <field name="reminder_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="library_loan_action" model="ir.actions.act_window">
        <field name="name">Emprunts</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="context">{'pivot_measures': ['__count', 'reminder_count']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer un premier emprunt</p>
            <p>Un emprunt relie un exemplaire à un adhérent, pour une durée.</p>
        </field>
    </record>

    <menuitem id="library_menu_loan" name="Emprunts" parent="library_menu_root"
              action="library_loan_action" sequence="40"/>

</odoo>
