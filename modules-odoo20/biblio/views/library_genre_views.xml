<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_genre_view_list" model="ir.ui.view">
        <field name="name">library.genre.list</field>
        <field name="model">library.genre</field>
        <field name="arch" type="xml">
            <list string="Genres">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="book_count"/>
            </list>
        </field>
    </record>

    <record id="library_genre_view_form" model="ir.ui.view">
        <field name="name">library.genre.form</field>
        <field name="model">library.genre</field>
        <field name="arch" type="xml">
            <form string="Genre">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom du genre"/>
                        </h1>
                    </div>
                    <group>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <notebook>
                        <page string="Livres" name="books">
                            <field name="book_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="author_id"/>
                                    <field name="copy_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_genre_action" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">library.genre</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un premier genre</p>
            <p>Un genre classe les livres ; un livre peut en avoir plusieurs.</p>
        </field>
    </record>

    <menuitem id="library_menu_config" name="Configuration" parent="library_menu_root" sequence="90"
              groups="group_library_manager"/>
    <menuitem id="library_menu_genre" name="Genres" parent="library_menu_config"
              action="library_genre_action" sequence="10"/>

</odoo>
