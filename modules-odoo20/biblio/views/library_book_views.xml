<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Livres">
                <field name="title"/>
                <field name="author_id"/>
                <field name="genre_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="isbn"/>
                <field name="publication_date"/>
                <field name="page_count"/>
            </list>
        </field>
    </record>

    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Livre">
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1>
                            <field name="title" placeholder="Titre du livre"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="author_id"/>
                            <field name="isbn"/>
                            <field name="genre_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="publication_date"/>
                            <field name="page_count"/>
                            <field name="copy_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Résumé">
                        <field name="summary" nolabel="1" placeholder="Quelques lignes sur le livre…"/>
                    </group>
                    <notebook>
                        <page string="Exemplaires" name="copies">
                            <field name="copy_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="acquisition_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Livres">
                <field name="title"/>
                <field name="author_id"/>
                <field name="genre_ids"/>
                <filter name="filter_no_genre" string="Sans genre" domain="[('genre_ids', '=', False)]"/>
                <group>
                    <filter name="group_genre" string="Genre" context="{'group_by': 'genre_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Livres</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer un premier livre</p>
            <p>Le catalogue de la bibliothèque est encore vide.</p>
        </field>
    </record>

    <menuitem id="library_menu_root" name="Bibliothèque" sequence="10"
              groups="group_library_desk"/>
    <menuitem id="library_menu_book" name="Livres" parent="library_menu_root"
              action="library_book_action" sequence="10"/>

</odoo>
