<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_shelf_view_list" model="ir.ui.view">
        <field name="name">library.shelf.list</field>
        <field name="model">library.shelf</field>
        <field name="arch" type="xml">
            <list string="Rayons">
                <field name="complete_name"/>
                <field name="copy_count"/>
            </list>
        </field>
    </record>

    <record id="library_shelf_view_form" model="ir.ui.view">
        <field name="name">library.shelf.form</field>
        <field name="model">library.shelf</field>
        <field name="arch" type="xml">
            <form string="Rayon">
                <sheet>
                    <div name="button_box">
                        <button name="action_view_copies" type="object" class="oe_stat_button" icon="book_5">
                            <field name="copy_count" widget="statinfo" string="Exemplaires"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Développement"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="complete_name"/>
                    </group>
                    <notebook>
                        <page string="Sous-rayons" name="children">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="copy_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_shelf_view_search" model="ir.ui.view">
        <field name="name">library.shelf.search</field>
        <field name="model">library.shelf</field>
        <field name="arch" type="xml">
            <search string="Rayons">
                <field name="complete_name"/>
                <filter string="Rayons racines" name="roots" domain="[('parent_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="library_shelf_action" model="ir.actions.act_window">
        <field name="name">Rayons</field>
        <field name="res_model">library.shelf</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un premier rayon</p>
            <p>Un rayon peut contenir des sous-rayons : Informatique / Odoo / Développement.</p>
        </field>
    </record>

    <menuitem id="library_menu_shelf" name="Rayons" parent="library_menu_config"
              action="library_shelf_action" sequence="20"/>

</odoo>
