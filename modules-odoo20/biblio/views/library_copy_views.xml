<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_copy_view_list" model="ir.ui.view">
        <field name="name">library.copy.list</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <list string="Exemplaires">
                <field name="name"/>
                <field name="book_id"/>
                <field name="state"/>
                <field name="acquisition_date"/>
            </list>
        </field>
    </record>

    <record id="library_copy_view_form" model="ir.ui.view">
        <field name="name">library.copy.form</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <form string="Exemplaire">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="BIB-0001"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="book_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="acquisition_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_copy_action" model="ir.actions.act_window">
        <field name="name">Exemplaires</field>
        <field name="res_model">library.copy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer un premier exemplaire</p>
            <p>Un exemplaire est un livre physique posé sur une étagère.</p>
        </field>
    </record>

    <menuitem id="library_menu_copy" name="Exemplaires" parent="library_menu_root"
              action="library_copy_action" sequence="20"/>

</odoo>
