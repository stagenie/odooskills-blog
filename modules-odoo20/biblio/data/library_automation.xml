<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Créée dans l'interface (Paramètres > Technique > Automatisation), puis recopiée ici. -->
    <record id="automation_copy_lost" model="base.automation">
        <field name="name">Exemplaire perdu : retirer du rayon</field>
        <field name="model_id" ref="model_library_copy"/>
        <field name="trigger">on_state_set</field>
        <field name="trg_selection_field_id" ref="selection__library_copy__state__lost"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('field_library_copy__state')])]"/>
        <field name="filter_domain">[('state', '=', 'lost')]</field>
    </record>

    <record id="action_copy_lost_clear_shelf" model="ir.actions.server">
        <field name="name">Vider le rayon</field>
        <field name="base_automation_id" ref="automation_copy_lost"/>
        <field name="usage">base_automation</field>
        <field name="model_id" ref="model_library_copy"/>
        <field name="state">object_write</field>
        <field name="update_path">shelf_id</field>
        <field name="evaluation_type">value</field>
    </record>

    <!-- 2. À la création et à la modification de la durée : passage au-dessus de 21 jours. -->
    <record id="automation_loan_long" model="base.automation">
        <field name="name">Emprunt de plus de 21 jours : à faire valider</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="trigger">on_create_or_write</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('field_library_loan__duration')])]"/>
        <field name="filter_pre_domain">[('duration', '&lt;=', 21)]</field>
        <field name="filter_domain">[('duration', '&gt;', 21), ('state', '=', 'ongoing')]</field>
    </record>

    <record id="action_loan_long_activity" model="ir.actions.server">
        <field name="name">Activité : faire valider la durée</field>
        <field name="base_automation_id" ref="automation_loan_long"/>
        <field name="usage">base_automation</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Faire valider une durée de plus de 21 jours</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">create_uid</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
    </record>

    <!-- 3. L'état passe à « Rendu » : accusé de retour par courriel (mis en file d'attente). -->
    <record id="automation_loan_returned" model="base.automation">
        <field name="name">Emprunt rendu : accusé de retour</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="trigger">on_state_set</field>
        <field name="trg_selection_field_id" ref="selection__library_loan__state__returned"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('field_library_loan__state')])]"/>
        <field name="filter_domain">[('state', '=', 'returned')]</field>
    </record>

    <record id="action_loan_returned_mail" model="ir.actions.server">
        <field name="name">Courriel : accusé de retour</field>
        <field name="base_automation_id" ref="automation_loan_returned"/>
        <field name="usage">base_automation</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="state">mail_post</field>
        <field name="template_id" ref="mail_template_loan_returned"/>
    </record>

    <!-- 4. Temporelle : 7 jours après la date de retour prévue, l'emprunt n'est toujours pas rendu. -->
    <record id="automation_loan_overdue" model="base.automation">
        <field name="name">Retard de 7 jours : appeler l'adhérent</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="trigger">on_time</field>
        <field name="trg_date_id" ref="field_library_loan__date_due"/>
        <field name="trg_date_range">7</field>
        <field name="trg_date_range_type">day</field>
        <field name="trg_date_range_mode">after</field>
        <field name="filter_domain">[('state', '=', 'ongoing')]</field>
    </record>

    <record id="action_loan_overdue_call" model="ir.actions.server">
        <field name="name">Activité : appeler l'adhérent</field>
        <field name="base_automation_id" ref="automation_loan_overdue"/>
        <field name="usage">base_automation</field>
        <field name="sequence">1</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
        <field name="activity_summary">Appeler l'adhérent : retard de plus de 7 jours</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">create_uid</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
    </record>

    <record id="action_loan_overdue_note" model="ir.actions.server">
        <field name="name">Code : note de retard et journal</field>
        <field name="base_automation_id" ref="automation_loan_overdue"/>
        <field name="usage">base_automation</field>
        <field name="sequence">2</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="state">code</field>
        <field name="code">
for emprunt in records:
    emprunt.message_post(
        body="Retard de %s jours : appel de l'adhérent planifié." % emprunt.days_late,
        subtype_xmlid='mail.mt_note',
    )
log("Retard de 7 jours : %s emprunt(s) traité(s)" % len(records))
</field>
    </record>

</odoo>
