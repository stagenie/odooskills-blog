<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_widget_demo_form" model="ir.ui.view">
        <field name="name">oski.widget.demo.form</field>
        <field name="model">oski.widget.demo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="draft,open,done"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button name="action_open_tags" type="object" class="oe_stat_button" icon="sell">
                            <field name="tag_count" widget="statinfo" string="Étiquettes"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                            <field name="name" placeholder="Nom de la fiche"/>
                        </h1>
                        <field name="priority" widget="priority"/>
                    </div>
                    <group>
                        <group string="Sélections et états" name="choix">
                            <field name="state" widget="badge" string="Étape (badge)"
                                   decoration-info="state == 'open'" decoration-success="state == 'done'"
                                   decoration-danger="state == 'cancel'"/>
                            <field name="state" widget="label_selection" string="Étape (étiquette)"
                                   options="{'classes': {'draft': 'secondary', 'open': 'info', 'done': 'success', 'cancel': 'danger'}}"/>
                            <field name="channel" widget="radio" options="{'horizontal': True}"/>
                            <field name="channel" widget="badges_selection" string="Canal (pastilles)"/>
                            <field name="category_id" widget="badges_many2one" options="{'badge_limit': 4}"/>
                        </group>
                        <group string="Nombres" name="nombres">
                            <field name="progress" widget="progressbar" options="{'max_value': 'target'}"/>
                            <field name="target"/>
                            <field name="rate" widget="percentage"/>
                            <field name="pie" widget="percentpie"/>
                            <field name="duration" widget="float_time"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" widget="monetary"/>
                            <field name="color" widget="color_picker"/>
                            <field name="color_hex" widget="color"/>
                        </group>
                        <group string="Relations" name="relations">
                            <field name="partner_id" widget="many2one_avatar"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="partner_ids" widget="many2many_tags_avatar"/>
                            <field name="tag_ids" widget="many2many_checkboxes" string="Étiquettes (cases)"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                        <group string="Textes, liens et dates" name="textes">
                            <field name="website" widget="url"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="reference_code" widget="CopyClipboardChar"/>
                            <field name="deadline" widget="relative_date"/>
                            <field name="date_start" widget="daterange" string="Période"
                                   options="{'end_date_field': 'date_end'}"/>
                            <field name="date_end" invisible="1"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="partner_domain" widget="domain" options="{'model': 'res.partner'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oski_widget_demo_list" model="ir.ui.view">
        <field name="name">oski.widget.demo.list</field>
        <field name="model">oski.widget.demo</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'" decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="partner_id" widget="many2one_avatar"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="partner_ids" optional="show"/>
                <field name="progress" widget="progressbar" options="{'max_value': 'target'}"/>
                <field name="target" column_invisible="1"/>
                <field name="rate" widget="percentage"/>
                <field name="pie" widget="percentpie" optional="hide"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="deadline" widget="relative_date"/>
            </list>
        </field>
    </record>

    <record id="view_oski_widget_demo_kanban" model="ir.ui.view">
        <field name="name">oski.widget.demo.kanban</field>
        <field name="model">oski.widget.demo</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="target" invisible="1"/>
                        <field name="progress" widget="progressbar" options="{'max_value': 'target'}"/>
                        <footer>
                            <field name="priority" widget="priority"/>
                            <field name="state" widget="badge" class="ms-2"/>
                            <field name="partner_id" widget="many2one_avatar" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_oski_widget_demo" model="ir.actions.act_window">
        <field name="name">Catalogue des widgets</field>
        <field name="res_model">oski.widget.demo</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_oski_widget_demo_root" name="Widgets (exemple)" sequence="200"
              action="action_oski_widget_demo"/>
</odoo>
