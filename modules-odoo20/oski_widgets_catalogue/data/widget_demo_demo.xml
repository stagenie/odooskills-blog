<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_widget_1" model="oski.widget.demo">
        <field name="name">Renouvellement du parc</field>
        <field name="sequence">1</field>
        <field name="state">open</field>
        <field name="priority">2</field>
        <field name="channel">phone</field>
        <field name="category_id" ref="base.res_partner_category_8"/>
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="tag_ids" eval="[(6, 0, [ref('base.res_partner_category_8'), ref('base.res_partner_category_11')])]"/>
        <field name="partner_ids" eval="[(6, 0, [ref('base.res_partner_12'), ref('base.res_partner_4')])]"/>
