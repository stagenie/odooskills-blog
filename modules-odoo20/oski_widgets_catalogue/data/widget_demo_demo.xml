        <field name="target">100</field>
        <field name="rate">0.125</field>
        <field name="pie">72</field>
        <field name="duration">1.75</field>
        <field name="amount">12480.5</field>
        <field name="color">4</field>
        <field name="color_hex">#017E84</field>
        <field name="is_favorite" eval="True"/>
        <field name="website">www.odoo.com</field>
        <field name="email">contact@example.com</field>
        <field name="phone">+33 1 23 45 67 89</field>
        <field name="reference_code">CMD-2026-0042</field>
        <field name="partner_domain">[("is_company", "=", True)]</field>
        <field name="deadline" eval="(DateTime.today() + relativedelta(days=4)).strftime('%Y-%m-%d')"/>
        <field name="date_start" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(days=14)).strftime('%Y-%m-%d')"/>
    </record>
