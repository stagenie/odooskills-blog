<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_commande" model="ir.actions.report">
        <field name="name">Fiche de commande</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oski_qweb_pdf.report_commande</field>
        <field name="paperformat_id" ref="paperformat_commande"/>
        <field name="print_report_name">'Commande - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_commande">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="oski_qweb_pdf.report_commande_document" t-lang="doc.partner_id.lang" doc="doc"/>
            </t>
        </t>
    </template>

    <template id="report_commande_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="address">
            <div t-field="doc.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </t>
        <t t-set="layout_document_title">
            <span class="o_commande_titre">Fiche de commande <span t-field="doc.name"/></span>
        </t>
        <t t-call="web.external_layout" o="doc" address="address" layout_document_title="layout_document_title">
            <div class="page">
                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Date de commande</strong>
                        <div t-field="doc.date_order" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="col-6">
                        <strong>Valable jusqu'au</strong>
                        <div t-field="doc.validity_date" t-options='{"format": "d MMMM yyyy"}'/>
                    </div>
                </div>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Article</th>
                            <th class="text-end">Quantité</th>
                            <th class="text-end">Montant HT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.order_line" t-as="line">
                            <td t-out="line.name"/>
                            <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="o_insecable mt-4">
                    <strong>Conditions</strong>
                    <p t-field="doc.note"/>
                </div>

                <div class="o_saut">
                    <h3 class="o_commande_titre">Bon pour accord</h3>
                    <p>Fait le <span t-out="context_timestamp(datetime.datetime.now())" t-options='{"widget": "date"}'/></p>
                </div>
            </div>
        </t>
    </template>
</odoo>
