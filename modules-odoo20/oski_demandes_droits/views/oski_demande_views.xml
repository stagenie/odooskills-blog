<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oski_demande_view_list" model="ir.ui.view">
        <field name="name">oski.demande.list</field>
        <field name="model">oski.demande</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="montant" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="oski_demande_view_form" model="ir.ui.view">
        <field name="name">oski.demande.form</field>
        <field name="model">oski.demande</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Soumettre" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approuver" class="btn-primary"
                            invisible="state != 'submitted'" groups="oski_demandes_droits.group_demande_valideur"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="montant"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Précisions…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oski_demande_action" model="ir.actions.act_window">
        <field name="name">Demandes internes</field>
        <field name="res_model">oski.demande</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="oski_demande_menu_root" name="Demandes" sequence="60"
              groups="group_demande_user" web_icon="base,static/description/icon.png"/>
    <menuitem id="oski_demande_menu" name="Demandes internes" parent="oski_demande_menu_root"
              action="oski_demande_action" sequence="10"/>
</odoo>
