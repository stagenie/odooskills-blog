<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_demandes" model="res.groups.privilege">
        <field name="name">Demandes internes</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_demande_user" model="res.groups">
        <field name="name">Demandeur</field>
        <field name="comment">Crée ses demandes et ne voit que les siennes.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_demandes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_demande_valideur" model="res.groups">
        <field name="name">Valideur</field>
        <field name="comment">Voit et approuve toutes les demandes de ses sociétés.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_demandes"/>
        <field name="implied_ids" eval="[(4, ref('group_demande_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
