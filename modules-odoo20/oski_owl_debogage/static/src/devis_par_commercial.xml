<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="oski_owl_debogage.DevisParCommercial">
        <div class="o_action o_devis_commercial h-100 overflow-auto p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <h2 class="m-0">Devis en cours par commercial</h2>
                <button type="button" class="o_devis_reload btn btn-secondary" t-on-click="this.load">Actualiser</button>
            </div>
            <table class="table table-sm w-auto">
                <thead><tr><th>Commercial</th><th class="text-end">Devis</th><th class="text-end">Total HT</th></tr></thead>
                <tbody>
                    <tr t-foreach="this.groups()" t-as="group" t-key="group.name" class="o_devis_group">
                        <td t-out="group.name"/>
                        <td class="text-end" t-out="group.count"/>
                        <td class="text-end" t-out="group.total.toFixed(2)"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

</templates>
