<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_materiel" model="ir.actions.report">
        <field name="name">Fiche de prêt</field>
        <field name="model">oski.parc.materiel</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">oski_parc.report_materiel</field>
        <field name="binding_model_id" ref="model_oski_parc_materiel"/>
    </record>

    <template id="materiel_fiche">
        <div class="page">
            <h2 t-out="titre"/>
            <p>Référence : <span t-out="o.reference"/></p>
            <p>Désignation : <span t-out="o.name"/></p>
            <p>Prêté à : <span t-out="o.partner_id.name"/></p>
        </div>
    </template>

    <template id="report_materiel">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="oski_parc.materiel_fiche" titre.f="Fiche de prêt"/>
            </t>
        </t>
    </template>
</odoo>
