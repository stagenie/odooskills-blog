<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="materiel_view_list" model="ir.ui.view">
        <field name="name">oski.parc.materiel.list</field>
        <field name="model">oski.parc.materiel</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="numero_serie"/>
                <field name="partner_id"/>
                <field name="date_pret"/>
            </list>
        </field>
    </record>

    <record id="materiel_view_form" model="ir.ui.view">
        <field name="name">oski.parc.materiel.form</field>
        <field name="model">oski.parc.materiel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="numero_serie"/>
                        <field name="reference"/>
                        <field name="partner_id"/>
                        <field name="date_pret"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="materiel_action" model="ir.actions.act_window">
        <field name="name">Matériel prêté</field>
        <field name="res_model">oski.parc.materiel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_parc_root" name="Parc" action="materiel_action" sequence="90"/>
</odoo>
